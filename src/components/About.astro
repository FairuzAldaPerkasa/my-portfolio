---
const stack = ["Python", "PHP", "JavaScript", "CodeIgniter", "TensorFlow", "Scikit-learn", "MySQL", "PostgreSQL", "Docker"];

---
<section id="about" class="section about">
  <div class="about-sparkles" id="about-sparkles" aria-hidden="true"></div>
  <div class="about-noise" aria-hidden="true"></div>
  <div class="about-grid-bg" aria-hidden="true"></div>
  <div class="about-aurora-container" aria-hidden="true">
    <div class="about-aurora about-aurora-1"></div>
    <div class="about-aurora about-aurora-2"></div>
    <div class="about-aurora about-aurora-3"></div>
  </div>
  <div class="about-spotlight" id="about-spot" aria-hidden="true"></div>

  <div class="about-container">
    <!-- Section Header -->
    <div class="about-header reveal" data-reveal>
      <div class="eyebrow-wrapper">
        <span class="dot"></span>
        <p class="eyebrow mono">01_ABOUT_ME</p>
      </div>
      <h2 class="title">Crafting digital <span class="grad">solutions</span></h2>
      <p class="subtitle">Full-Stack Web Developer & Sistem Analis dengan keunggulan di Machine Learning.</p>
    </div>

    <div class="about-main">
      <!-- Content Side -->
      <div class="about-content reveal" data-reveal style="--d:0.08s">
        <div class="text-group">
          <p class="desc">
            Mahasiswa Informatika UAD <span class="hl">(IPK 3.94)</span> yang membangun sistem end-to-end
            dari spesifikasi hingga deployment — dibentuk lewat magang di <span class="hl">PT. Sasa Inti</span>
            dan <span class="hl">Bangkit Academy ML Cohort</span> oleh Google.
          </p>
        </div>

        <div class="stack-wrapper">
          <span class="stack-label mono">CORE TOOLKIT</span>
          <ul class="stack-pills">
            {stack.map((item) => (
              <li class="pill mono">{item}</li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Editor Card Side -->
      <div class="about-card reveal track-cursor tilt-card" data-reveal data-tilt style="--d:0.16s">
        <div class="card-border-glow"></div>
        <div class="hover-glow"></div>
        <div class="editor-chrome">
          <div class="dots"><span></span><span></span><span></span></div>
          <span class="file-name mono">developer.ts</span>
        </div>
        <pre class="about-code mono"><code><span class="kw">const</span> <span class="var">profile</span> = {
  <span class="key">role</span>: <span class="str">"Full-Stack Dev & Sistem Analis"</span>,
  <span class="key">education</span>: <span class="str">"S1 Informatika, UAD"</span>,
  <span class="key">gpa</span>: <span class="str">"3.94 / 4.00"</span>,
  <span class="key">status</span>: <span class="str">"Open to Opportunities"</span>
};</code></pre>
      </div>
    </div>
  </div>
</section>

<style>
  /* Base Layout */
  /* Override global .section (max-width:68rem; margin:0 auto; padding:7rem 1.5rem)
     so this section itself spans the full viewport width; the inner
     .about-container below handles the readable content max-width instead. */
  .about {
    max-width: none;
    min-height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0;
    padding: 7rem 0;
    position: relative;
    background-color: var(--bg-base);
    overflow: hidden;
    box-sizing: border-box;
    transition: background-color 0.4s ease;
  }
  .about-container { width: 100%; max-width: 76rem; margin: 0 auto; padding: 0 2rem; position: relative; z-index: 10; box-sizing: border-box; }

  /* Grain texture for premium depth */
  .about-noise {
    position: absolute; inset: 0; z-index: 5; pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: var(--noise-op, 0.03); mix-blend-mode: overlay;
  }

  /* Grid pattern (matches Hero's grid-bg) */
  .about-grid-bg {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background-image: linear-gradient(to right, var(--grid-color, rgba(28,25,23,0.05)) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-color, rgba(28,25,23,0.05)) 1px, transparent 1px);
    background-size: 3rem 3rem;
    mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 80%);
    transition: background-image 0.5s ease;
  }

  /* Aurora blobs (matches Hero's aurora-container) */
  .about-aurora-container { position: absolute; inset: 0; z-index: 2; overflow: hidden; pointer-events: none; }
  .about-aurora {
    position: absolute; width: 45vw; height: 45vh; border-radius: 50%;
    filter: blur(80px); opacity: 0.7;
    animation: aboutAuroraMove 15s ease-in-out infinite alternate;
    transition: background 0.5s ease;
  }
  .about-aurora-1 { top: 0; left: 8%; background: radial-gradient(circle, var(--a-1, rgba(59,130,246,0.15)) 0%, transparent 70%); }
  .about-aurora-2 { bottom: 5%; right: 8%; background: radial-gradient(circle, var(--a-2, rgba(168,85,247,0.12)) 0%, transparent 70%); animation-delay: -5s; }
  .about-aurora-3 { top: 35%; left: 38%; width: 36vw; background: radial-gradient(circle, color-mix(in srgb, var(--teal) 15%, transparent) 0%, transparent 70%); animation-delay: -10s; }
  @keyframes aboutAuroraMove {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(8%, 8%) scale(1.15); }
  }

  /* Floating sparkles (matches Hero's sparkles-container) */
  .about-sparkles { position: absolute; inset: 0; z-index: 4; overflow: hidden; pointer-events: none; }
  :global(.about-sparkle) {
    position: absolute; border-radius: 50%; background-color: var(--sparkle-color, rgba(15,23,42,0.15));
    box-shadow: 0 0 10px 1px var(--sparkle-color, rgba(15,23,42,0.15)); opacity: 0;
    animation: aboutFloatUp var(--duration) linear infinite; animation-delay: var(--delay);
  }
  @keyframes aboutFloatUp {
    0% { transform: translateY(0) scale(0); opacity: 0; }
    10% { opacity: 1; transform: translateY(-10px) scale(1); }
    90% { opacity: 1; transform: translateY(calc(var(--distance) - 10px)) scale(1); }
    100% { transform: translateY(var(--distance)) scale(0); opacity: 0; }
  }

  /* Mouse-tracking spotlight (matches Hero's spotlight) */
  .about-spotlight {
    position: absolute; inset: 0; z-index: 6; pointer-events: none;
    background: radial-gradient(800px circle at var(--mx, 50%) var(--my, 50%), var(--spot-color, rgba(15,23,42,0.03)), transparent 40%);
  }

  /* Header */
  .about-header { text-align: center; max-width: 40rem; margin: 0 auto 4.5rem; }
  .eyebrow-wrapper { display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .eyebrow {
    font-size: 0.78rem; color: var(--primary);
    letter-spacing: 0.22em; text-transform: uppercase;
  }
  .dot { width: 8px; height: 8px; background: var(--primary); border-radius: 50%; box-shadow: 0 0 4px color-mix(in srgb, var(--primary-glow) 70%, transparent); flex-shrink: 0; }

  .title { font-size: clamp(2.5rem, 6vw, 3.5rem); margin-bottom: 0.9rem; font-weight: 800; line-height: 1.1; letter-spacing: -0.01em; color: var(--text); }
  .grad {
    color: var(--primary);
  }
  .subtitle { font-size: 1.02rem; color: var(--text-muted); letter-spacing: 0.01em; }

  /* Main Grid */
  .about-main {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: center;
    margin-bottom: 4.5rem;
  }

  .desc {
    font-size: 1.12rem; line-height: 1.9; color: var(--text-muted);
    padding-left: 1.25rem;
    border-left: 2px solid var(--border-color);
  }
  .hl { color: var(--text); font-weight: 600; }
  .text-group { display: flex; flex-direction: column; gap: 1.4rem; margin-bottom: 2.5rem; }

  /* Tech Stack Pills */
  .stack-wrapper { display: flex; flex-direction: column; gap: 0.9rem; }
  .stack-label {
    font-size: 0.7rem; letter-spacing: 0.18em; color: var(--text-muted); opacity: 0.7;
  }
  .stack-pills { display: flex; flex-wrap: wrap; gap: 0.65rem; list-style: none; padding: 0; margin: 0; }
  .pill {
    font-size: 0.8rem; padding: 0.5rem 1rem;
    border-radius: 9999px; color: var(--text);
    background: var(--card-bg); border: 1px solid var(--border-color);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pill:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px -8px var(--primary-glow, rgba(59,130,246,0.4));
  }

  /* Premium Card (Glassmorphism) */
  .about-card {
    position: relative;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: var(--card-shadow);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .about-card:hover { border-color: var(--primary); box-shadow: 0 30px 60px -15px rgba(59, 130, 246, 0.2); }

  .card-border-glow {
    position: absolute; inset: 0; border-radius: 24px; z-index: 0;
    padding: 1.5px;
    background: linear-gradient(135deg, var(--primary), transparent 45%, transparent 55%, #9C2760);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0; transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .about-card:hover .card-border-glow { opacity: 1; }

  /* Code Block Styling */
  .editor-chrome {
    position: relative; z-index: 1;
    display: flex; align-items: center; gap: 1rem;
    padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color);
    background: var(--header-bg);
  }
  .dots { display: flex; gap: 8px; }
  .dots span { width: 12px; height: 12px; border-radius: 50%; background: var(--border-color); }
  .file-name { font-size: 0.8rem; color: var(--text-muted); opacity: 0.7; }

  .about-code {
    position: relative; z-index: 1; margin: 1px;
    background: var(--bg-base);
    padding: 2rem; font-size: 0.95rem; line-height: 2.2;
    overflow-x: auto; color: var(--text);
  }
  .kw { color: #9C2760; }
  .var { color: var(--text); }
  .key { color: var(--primary); }
  .str { color: var(--teal); }

  /* Interactive Cursor Glow */
  .track-cursor { position: relative; }
  .hover-glow {
    position: absolute; inset: 0; z-index: 1;
    background: radial-gradient(400px circle at var(--hx, 50%) var(--hy, 50%), rgba(59, 130, 246, 0.15), transparent 50%);
    opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
  }
  .track-cursor:hover .hover-glow { opacity: 1; }

  /* Reveal */
  .reveal {
    opacity: 0; transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: var(--d, 0s);
  }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }

  /* Responsive */
  @media (max-width: 900px) {
    .about-main { grid-template-columns: 1fr; gap: 3rem; }
    .about { padding: 6rem 0; min-height: auto; }
    .about-header { margin-bottom: 3.5rem; }
  }

  /* Compact mobile */
  @media (max-width: 640px) {
    .about { padding: 3rem 0; }
    .about-container { padding: 0 1rem; }
    .about-header { margin-bottom: 1.75rem; }
    #about h2.title { font-size: 1.6rem; margin-bottom: 0.4rem; }
    #about .eyebrow { font-size: 0.62rem; }
    #about .subtitle { font-size: 0.82rem; }
    .eyebrow-wrapper { margin-bottom: 0.75rem; gap: 0.5rem; }
    .about-main { gap: 1.25rem; margin-bottom: 1.5rem; }
    .desc { font-size: 0.85rem; line-height: 1.6; padding-left: 0.75rem; }
    .text-group { gap: 0.75rem; margin-bottom: 1rem; }
    .stack-label { font-size: 0.62rem; }
    .stack-pills { gap: 0.35rem; }
    .pill { font-size: 0.66rem; padding: 0.32rem 0.65rem; }
    .editor-chrome { padding: 0.65rem 0.85rem; gap: 0.5rem; }
    .dots span { width: 8px; height: 8px; }
    .file-name { font-size: 0.7rem; }
    .about-code { padding: 0.9rem; font-size: 0.72rem; line-height: 1.65; }
  }

  /* Theme Variables untuk Kedalaman (Depth) */
  :root {
    --bg-base: #FAF8F3;
    --card-bg: rgba(255, 255, 255, 0.72);
    --header-bg: rgba(255, 255, 255, 0.5);
    --border-color: rgba(28, 25, 23, 0.08);
    --card-shadow: 0 20px 40px -10px rgba(28,25,23,0.08);
  }
  :global(.dark) {
    --bg-base: #0B0A08;
    --card-bg: rgba(27, 23, 18, 0.55);
    --header-bg: rgba(0, 0, 0, 0.25);
    --border-color: rgba(245, 239, 224, 0.08);
    --card-shadow: 0 20px 40px -10px rgba(0,0,0,0.55);
  }
</style>

<script is:inline>
  (() => {
    // Hover Glow Effect
    document.querySelectorAll("#about .track-cursor").forEach((el) => {
      el.addEventListener("mousemove", (e) => {
        const rect = el.getBoundingClientRect();
        el.style.setProperty("--hx", `${e.clientX - rect.left}px`);
        el.style.setProperty("--hy", `${e.clientY - rect.top}px`);
      });
    });

    // Floating sparkles (matches Hero)
    const sparklesContainer = document.getElementById("about-sparkles");

    // Lightweight canvas-based sparkle renderer (replaces per-particle DOM nodes for perf)
    function mountSparkleCanvas(container, count, fallbackColor) {
      const canvas = document.createElement("canvas");
      canvas.style.cssText = "position:absolute;inset:0;width:100%;height:100%;display:block;";
      container.appendChild(canvas);
      const ctx = canvas.getContext("2d");
      const color = (getComputedStyle(container).getPropertyValue("--sparkle-color") || "").trim() || fallbackColor;
      let w = 0, h = 0, raf = null;
      const resize = () => { w = canvas.width = container.clientWidth; h = canvas.height = container.clientHeight; };
      resize();
      window.addEventListener("resize", resize);
      const particles = Array.from({ length: count }, () => ({
        x: Math.random() * 100,
        y: Math.random() * 120 - 10,
        r: Math.random() * 1.5 + 0.5,
        speed: Math.random() * 0.012 + 0.006,
        drift: (Math.random() - 0.5) * 0.015,
        phase: Math.random() * Math.PI * 2,
      }));
      function draw() {
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = color;
        for (const p of particles) {
          p.y -= p.speed;
          p.x += p.drift;
          if (p.y < -10) { p.y = 110; p.x = Math.random() * 100; }
          const alpha = 0.35 + 0.65 * Math.pow(Math.sin(p.phase + p.y * 0.05), 2);
          ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
          ctx.beginPath();
          ctx.arc((p.x / 100) * w, (p.y / 100) * h, p.r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
        raf = requestAnimationFrame(draw);
      }
      draw();
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) { if (raf) cancelAnimationFrame(raf); raf = null; }
        else if (!raf) draw();
      });
    }

    if (sparklesContainer && window.innerWidth > 768) {
      // Perf: single <canvas> + rAF loop instead of 22 individual DOM nodes/animations
      mountSparkleCanvas(sparklesContainer, 22, "rgba(15,23,42,0.15)");
    }

    // Mouse-tracking spotlight (matches Hero)
    const aboutSection = document.querySelector("#about.about");
    const spot = document.getElementById("about-spot");
    if (aboutSection && spot && window.innerWidth > 780) {
      aboutSection.addEventListener("mousemove", (e) => {
        const rect = aboutSection.getBoundingClientRect();
        spot.style.setProperty("--mx", `${e.clientX - rect.left}px`);
        spot.style.setProperty("--my", `${e.clientY - rect.top}px`);
      });
    }

    // Reveal on scroll
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );
    document.querySelectorAll("#about [data-reveal]").forEach((el) => observer.observe(el));

    // Subtle 3D tilt on the editor card
    if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches && window.innerWidth > 900) {
      document.querySelectorAll("#about [data-tilt]").forEach((card) => {
        let rafId = null;
        card.addEventListener("mousemove", (e) => {
          const rect = card.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width - 0.5;
          const py = (e.clientY - rect.top) / rect.height - 0.5;
          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => {
            card.style.transform = `perspective(1000px) rotateY(${px * 6}deg) rotateX(${-py * 6}deg) translateY(-4px)`;
          });
        });
        card.addEventListener("mouseleave", () => {
          if (rafId) cancelAnimationFrame(rafId);
          card.style.transform = "perspective(1000px) rotateY(0deg) rotateX(0deg) translateY(0)";
        });
      });
    }
  })();
</script>