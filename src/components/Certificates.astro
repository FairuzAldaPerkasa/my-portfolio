---
import { Image } from "astro:assets";
import certificate1 from "../assets/certificates/certificate1.jpg";
import certificate2 from "../assets/certificates/certificate2.jpg";
import certificate3 from "../assets/certificates/certificate3.jpg";
import certificate4 from "../assets/certificates/certificate4.jpg";

const certificates = [
  {
     name: "Machine Learning Specialization",
    issuer: "Coursera",
    year: "2024",
    description: "Menyelesaikan spesialisasi Machine Learning yang mencakup supervised learning, unsupervised learning, neural networks, decision trees, clustering, anomaly detection, recommender systems, reinforcement learning, serta penerapan machine learning untuk menyelesaikan permasalahan dunia nyata.",
    url: "https://coursera.org/share/9c7d5ee82ffad226d39afc948e43a7a3",
    image: certificate1,
  },
  {
   name: "DeepLearning.AI TensorFlow Developer",
    issuer: "Coursera",
    year: "2024",
    description: "Mempelajari pengembangan model deep learning menggunakan TensorFlow, mencakup CNN, NLP, dan time series untuk membangun solusi AI yang efektif.",
    url: "https://coursera.org/share/bbf67a834350baf73441495ffdc11bc4",
    image: certificate2,
  },
  {
    name: "Bangkit Academy 2024 Batch 2 – Machine Learning Learning Path",
    issuer: "Bangkit Academy",
    year: "2024",
    description: "Berhasil menyelesaikan program Bangkit Academy 2024 pada Learning Path Machine Learning dengan mempelajari machine learning, deep learning, TensorFlow, data analysis, Python, MLOps, generative AI, serta mengembangkan proyek akhir berbasis AI.",
    url: "M179B4KY1359",
    image: certificate3,
  },
  {
    name: "Laboratory Asistant",
    issuer: "Laboratorium Informatika Universitas Ahmad Dahlan",
    year: "2024",
    description: "Membantu pelaksanaan praktikum, memberikan bimbingan kepada mahasiswa, serta mendukung penyusunan, pengujian, dan evaluasi materi praktikum di laboratorium.",
    url: "-",
    image: certificate4,
  },
];
---
<section id="certificates" class="section certificates">
  <div class="certificates-sparkles" id="certificates-sparkles" aria-hidden="true"></div>
  <div class="certificates-noise" aria-hidden="true"></div>
  <div class="certificates-grid-bg" aria-hidden="true"></div>
  <div class="certificates-aurora-container" aria-hidden="true">
    <div class="certificates-aurora certificates-aurora-1"></div>
    <div class="certificates-aurora certificates-aurora-2"></div>
    <div class="certificates-aurora certificates-aurora-3"></div>
  </div>
  <div class="certificates-spotlight" id="certificates-spot" aria-hidden="true"></div>

  <div class="certificates-container">
    <div class="section-head certificates-head reveal" data-reveal>
      <div class="eyebrow-wrapper">
        <span class="dot"></span>
        <p class="eyebrow mono">06_CERTIFICATES</p>
      </div>
      <h2>Certificates</h2>
      <p class="subtitle">Credentials that back up the skills above.</p>
    </div>

    <div class="cert-grid">
      {certificates.map((cert, i) => (
        <article class="card cert-card reveal track-cursor" data-reveal data-tilt data-glow style={`--d:${i * 0.08}s; --accent: var(--pink);`}>
          <div class="hover-glow"></div>
          <div class="cert-topline" aria-hidden="true"></div>
          <button class="cert-preview" data-cert-open
            data-name={cert.name} data-issuer={cert.issuer} data-year={cert.year}
            data-desc={cert.description} data-url={cert.url} data-image={cert.image.src}
            aria-label={`Preview ${cert.name}`}>
            {cert.image ? (
              <Image src={cert.image} alt={`Sertifikat ${cert.name}`} class="cert-thumb" loading="lazy" />
            ) : (
              <span class="cert-icon" aria-hidden="true">🎓</span>
            )}
            <span class="mono cert-preview-label">preview</span>
          </button>
          <h3>{cert.name}</h3>
          <div class="cert-meta-row">
            <p class="chip chip-pink cert-meta">{cert.issuer}</p>
            <span class="cert-year mono">{cert.year}</span>
          </div>
          <p class="text-muted cert-desc">{cert.description}</p>
          <a href={cert.url} target="_blank" rel="noopener" class="cert-link">View Credential ↗</a>
        </article>
      ))}
    </div>
  </div>
</section>

<div class="modal-backdrop" id="cert-modal">
  <div class="modal-box">
    <button class="modal-close" id="cert-modal-close" aria-label="Close preview">✕</button>
    <img id="cert-modal-image" class="cert-modal-thumb" alt="" style="display:none;" />
    <span class="cert-icon" id="cert-modal-icon" style="font-size:2.5rem;" aria-hidden="true">🎓</span>
    <h3 id="cert-modal-name" style="margin-top:0.75rem;"></h3>
    <p class="chip chip-pink" id="cert-modal-meta" style="margin:0.6rem 0;"></p>
    <p class="text-muted" id="cert-modal-desc"></p>
    <a href="#" target="_blank" rel="noopener" class="btn btn-primary" id="cert-modal-link" style="margin-top:1rem;">View Credential ↗</a>
  </div>
</div>

<style>
  .certificates {
    position: relative;
    overflow: hidden;
    padding: 4.5rem 0;
    background-color: var(--bg-base, var(--bg));
  }

  .certificates-container {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 2rem;
    box-sizing: border-box;
  }

  .certificates-sparkles,
  .certificates-noise,
  .certificates-grid-bg,
  .certificates-aurora-container,
  .certificates-spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .certificates-noise {
    z-index: 5;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: var(--noise-op, 0.03);
    mix-blend-mode: overlay;
  }

  .certificates-grid-bg {
    z-index: 1;
    background-image: linear-gradient(to right, var(--grid-color, rgba(15,23,42,0.05)) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-color, rgba(15,23,42,0.05)) 1px, transparent 1px);
    background-size: 3rem 3rem;
    mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 80%);
  }

  .certificates-sparkles { z-index: 4; overflow: hidden; }

  :global(.certificates-sparkle) {
    position: absolute;
    border-radius: 50%;
    background-color: var(--sparkle-color, rgba(255,93,162,0.18));
    box-shadow: 0 0 10px 1px var(--sparkle-color, rgba(255,93,162,0.18));
    opacity: 0;
    animation: certificatesFloatUp var(--duration) linear infinite;
    animation-delay: var(--delay);
  }

  @keyframes certificatesFloatUp {
    0% { transform: translateY(0) scale(0); opacity: 0; }
    10% { opacity: 1; transform: translateY(-10px) scale(1); }
    90% { opacity: 1; transform: translateY(calc(var(--distance) - 10px)) scale(1); }
    100% { transform: translateY(var(--distance)) scale(0); opacity: 0; }
  }

  .certificates-aurora-container { z-index: 2; overflow: hidden; }
  .certificates-aurora { position: absolute; width: 45vw; height: 45vh; border-radius: 50%; filter: blur(80px); opacity: 0.68; animation: certificatesAuroraMove 15s ease-in-out infinite alternate; }
  .certificates-aurora-1 { top: 0; left: 8%; background: radial-gradient(circle, rgba(79,70,229,0.14) 0%, transparent 70%); }
  .certificates-aurora-2 { bottom: 5%; right: 8%; background: radial-gradient(circle, rgba(255,107,107,0.12) 0%, transparent 70%); animation-delay: -5s; }
  .certificates-aurora-3 { top: 35%; left: 38%; width: 36vw; background: radial-gradient(circle, rgba(255,93,162,0.14) 0%, transparent 70%); animation-delay: -10s; }
  @keyframes certificatesAuroraMove { 0% { transform: translate(0, 0) scale(1); } 100% { transform: translate(8%, 8%) scale(1.15); } }

  .certificates-spotlight { z-index: 6; background: radial-gradient(800px circle at var(--mx, 50%) var(--my, 50%), rgba(255,93,162,0.06), transparent 40%); }

  .certificates-head { text-align: center; max-width: 40rem; margin: 0 auto 2.5rem; position: relative; z-index: 10; }
  .eyebrow-wrapper { display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .dot { width: 8px; height: 8px; background: var(--primary); border-radius: 50%; }

  .cert-grid { position: relative; z-index: 10; display: grid; grid-template-columns: repeat(auto-fit,minmax(260px,1fr)); gap: 1.15rem; }
  .cert-card {
    position: relative;
    padding: 0;
    overflow: hidden;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface) 96%, transparent), color-mix(in srgb, var(--bg-alt) 82%, transparent));
    border-radius: 24px;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
    box-shadow: 0 18px 40px -24px color-mix(in srgb, var(--accent) 30%, transparent);
    backdrop-filter: blur(20px);
  }

  .hover-glow {
    position: absolute; inset: 0; z-index: 1;
    background: radial-gradient(400px circle at var(--hx, 50%) var(--hy, 50%), color-mix(in srgb, var(--accent) 24%, transparent), transparent 50%);
    opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
  }
  .track-cursor:hover .hover-glow { opacity: 1; }

  .cert-topline { position: absolute; inset: 0 auto auto 0; width: 100%; height: 4px; background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 35%, transparent), transparent); z-index: 2; opacity: 0.95; }
  .cert-card h3 { font-weight: 600; font-size: 1.08rem; line-height: 1.25; margin: 0; }
  .cert-link { font-size: 0.85rem; color: var(--primary); font-weight: 600; text-decoration: none; }
  .cert-link:hover { text-decoration: underline; }
  .cert-preview {
    width: 100%;
    background: linear-gradient(180deg, color-mix(in srgb, var(--bg-alt) 88%, transparent), color-mix(in srgb, var(--surface) 95%, transparent));
    border: 1px dashed color-mix(in srgb, var(--accent) 26%, var(--border));
    border-radius: 16px;
    padding: 0.85rem 1.15rem;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.3rem;
    margin-bottom: 0.75rem;
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .cert-preview:hover { border-color: var(--primary); transform: translateY(-2px) scale(1.01); box-shadow: 0 12px 24px -18px color-mix(in srgb, var(--accent) 50%, transparent); }
  .cert-icon { font-size: 1.8rem; }
  .cert-thumb {
    width: 100%;
    max-height: 6rem;
    object-fit: contain;
    border-radius: 10px;
  }
  .cert-modal-thumb {
    max-width: 100%;
    max-height: 14rem;
    object-fit: contain;
    border-radius: 12px;
    margin: 0 auto;
    display: block;
  }
  .cert-preview-label { font-size: 0.7rem; color: var(--text-muted); letter-spacing: 0.08em; text-transform: uppercase; }
  .cert-meta-row { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin: 0.4rem 0 0.6rem; }
  .cert-meta { margin: 0; }
  .cert-year { font-size: 0.76rem; letter-spacing: 0.08em; text-transform: uppercase; color: color-mix(in srgb, var(--accent) 70%, var(--text-muted)); }
  .cert-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 0 0 0.65rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cert-card { display: flex; flex-direction: column; }
  .cert-card h3, .cert-desc, .cert-link, .cert-meta-row { padding-left: 1.15rem; padding-right: 1.15rem; }
  .cert-card h3 { padding-top: 0.1rem; }
  .cert-link { padding-bottom: 1.15rem; }

  @media (max-width: 640px) {
    .certificates-container { padding: 0 1.25rem; }
    .cert-card h3, .cert-desc, .cert-link, .cert-meta-row { padding-left: 1rem; padding-right: 1rem; }
    .cert-link { padding-bottom: 1rem; }
  }

  /* Compact mobile */
  @media (max-width: 640px) {
    .certificates { padding: 3rem 0; }
    .certificates-container { padding: 0 1rem; }
    .certificates-head { margin: 0 auto 1.75rem; }
    #certificates h2 { font-size: 1.5rem; }
    #certificates .eyebrow { font-size: 0.62rem; }
    #certificates .subtitle { font-size: 0.8rem; }
    .cert-grid { gap: 0.75rem; }
    .cert-card h3, .cert-desc, .cert-link, .cert-meta-row { padding-left: 0.85rem; padding-right: 0.85rem; }
    .cert-link { padding-bottom: 0.85rem; }
    .cert-card h3 { font-size: 0.88rem; }
    .cert-desc { font-size: 0.76rem; line-height: 1.5; margin-bottom: 0.5rem; }
    .cert-preview { padding: 0.75rem 0.85rem; margin-bottom: 0.6rem; border-radius: 14px; }
    .cert-icon { font-size: 1.2rem; }
    .cert-thumb { max-height: 4.5rem; }
    .cert-preview-label { font-size: 0.6rem; }
    .cert-meta-row { gap: 0.5rem; margin: 0.35rem 0 0.6rem; }
    .cert-year { font-size: 0.66rem; }
    .cert-link { font-size: 0.76rem; }
  }
</style>

<script is:inline>
  (() => {
    const modal = document.getElementById("cert-modal");
    const closeBtn = document.getElementById("cert-modal-close");
    const nameEl = document.getElementById("cert-modal-name");
    const metaEl = document.getElementById("cert-modal-meta");
    const descEl = document.getElementById("cert-modal-desc");
    const linkEl = document.getElementById("cert-modal-link");
    const imageEl = document.getElementById("cert-modal-image");
    const iconEl = document.getElementById("cert-modal-icon");
    const section = document.querySelector("#certificates.certificates");
    const spotlight = document.getElementById("certificates-spot");
    const sparklesContainer = document.getElementById("certificates-sparkles");

    document.querySelectorAll("[data-cert-open]").forEach((btn) => {
      btn.addEventListener("click", () => {
        nameEl.textContent = btn.dataset.name;
        metaEl.textContent = `${btn.dataset.issuer} · ${btn.dataset.year}`;
        descEl.textContent = btn.dataset.desc;
        linkEl.href = btn.dataset.url;
        if (btn.dataset.image) {
          imageEl.src = btn.dataset.image;
          imageEl.alt = `Sertifikat ${btn.dataset.name}`;
          imageEl.style.display = "block";
          iconEl.style.display = "none";
        } else {
          imageEl.style.display = "none";
          iconEl.style.display = "inline";
        }
        modal.classList.add("open");
      });
    });

    function closeModal() { modal.classList.remove("open"); }
    closeBtn.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });

    if (section && spotlight) {
      section.addEventListener("mousemove", (e) => {
        const rect = section.getBoundingClientRect();
        spotlight.style.setProperty("--mx", `${e.clientX - rect.left}px`);
        spotlight.style.setProperty("--my", `${e.clientY - rect.top}px`);

        document.querySelectorAll("#certificates .track-cursor").forEach((card) => {
          const cardRect = card.getBoundingClientRect();
          card.style.setProperty("--hx", `${e.clientX - cardRect.left}px`);
          card.style.setProperty("--hy", `${e.clientY - cardRect.top}px`);
        });
      });
    }

    if (sparklesContainer && window.innerWidth > 768) {
      const particleCount = 16;
      for (let i = 0; i < particleCount; i++) {
        const sparkle = document.createElement("div");
        sparkle.classList.add("certificates-sparkle");

        const size = Math.random() * 3 + 1;
        const left = Math.random() * 100;
        const duration = Math.random() * 10 + 10;
        const delay = Math.random() * -20;
        const distance = (Math.random() * 50 + 50) * -1;

        sparkle.style.width = `${size}px`;
        sparkle.style.height = `${size}px`;
        sparkle.style.left = `${left}%`;
        sparkle.style.bottom = `${Math.random() * 20 - 10}%`;
        sparkle.style.setProperty("--duration", `${duration}s`);
        sparkle.style.setProperty("--delay", `${delay}s`);
        sparkle.style.setProperty("--distance", `${distance}vh`);

        sparklesContainer.appendChild(sparkle);
      }
    }

    const revealEls = document.querySelectorAll("#certificates [data-reveal]");
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    revealEls.forEach((el) => revealObserver.observe(el));
  })();
</script>