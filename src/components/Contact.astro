---
---
<section id="contact" class="section contact">
  <div class="contact-sparkles" id="contact-sparkles" aria-hidden="true"></div>
  <div class="aurora-bg contact-aurora"></div>
  <div class="contact-noise" aria-hidden="true"></div>

  <div class="contact-container">
    <div class="contact-shell">
      <div class="contact-grid">
      <div class="reveal contact-copy" data-reveal>
        <div class="eyebrow-wrapper">
          <span class="dot"></span>
          <p class="eyebrow mono">09_CONTACT</p>
        </div>
        <h2>Let's build something <span class="grad">great</span> together</h2>
        <p class="contact-lead text-muted">
          Whether you have a project in mind, an opportunity to discuss, or just want to
          connect — I'd love to hear from you.
        </p>
        <div class="contact-pills" aria-label="Contact highlights">
          <span class="chip chip-indigo">Open to freelance</span>
          <span class="chip chip-teal">Available for collaboration</span>
        </div>
        <div class="contact-links">
          <a href="mailto:fairuzaldaperkasa@email.com" class="btn btn-outline magnetic" data-magnetic>Email</a>
          <a href="https://linkedin.com/in/fairuzaldaperkasa" target="_blank" rel="noopener" class="btn btn-outline magnetic" data-magnetic>LinkedIn</a>
          <a href="https://github.com/fairuzaldaperkasa" target="_blank" rel="noopener" class="btn btn-outline magnetic" data-magnetic>GitHub</a>
          <a href="https://wa.me/6285237693244" target="_blank" rel="noopener" class="btn btn-primary magnetic" data-magnetic>WhatsApp</a>
        </div>
      </div>

      <form class="card contact-form reveal track-cursor" data-reveal style="--d:0.12s; --accent: var(--primary);" data-contact-form>
        <div class="hover-glow"></div>
        <div class="contact-topline" aria-hidden="true"></div>
        <div class="editor-chrome">
          <span></span><span></span><span></span>
          <span class="file-name">message.send()</span>
        </div>
        <div class="form-fields">
          <div class="form-intro">
            <span class="form-kicker mono">DIRECT LINE</span>
            <p>Send a short brief and I’ll get back with a clear next step.</p>
          </div>
          <div class="field-float">
            <input id="name" name="name" type="text" placeholder=" " required minlength="2" data-validate />
            <label for="name">Name</label>
            <span class="field-error" data-error-for="name"></span>
          </div>
          <div class="field-float">
            <input id="email" name="email" type="email" placeholder=" " required data-validate />
            <label for="email">Email</label>
            <span class="field-error" data-error-for="email"></span>
          </div>
          <div class="field-float">
            <textarea id="message" name="message" placeholder=" " required minlength="10" data-validate></textarea>
            <label for="message">Message</label>
            <span class="field-error" data-error-for="message"></span>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center;">
            <span data-btn-label>Send Message</span>
          </button>
        </div>
      </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    padding-top: 8rem;
  }

  .contact-container {
    position: relative;
    z-index: 10;
  }

  .contact-shell {
    max-width: 76rem;
    margin: 0 auto;
    padding: 1.25rem;
    border-radius: 30px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface) 92%, transparent), color-mix(in srgb, var(--bg-alt) 86%, transparent));
    border: 1px solid color-mix(in srgb, var(--border) 78%, transparent);
    box-shadow: 0 24px 60px -34px color-mix(in srgb, var(--primary) 28%, transparent);
    backdrop-filter: blur(18px);
  }

  .contact-noise,
  .contact-sparkles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .contact-noise {
    z-index: 5;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: var(--noise-op, 0.03);
    mix-blend-mode: overlay;
  }

  .contact-sparkles {
    z-index: 4;
    overflow: hidden;
  }

  :global(.contact-sparkle) {
    position: absolute;
    border-radius: 50%;
    background-color: var(--sparkle-color, rgba(79,70,229,0.16));
    box-shadow: 0 0 10px 1px var(--sparkle-color, rgba(79,70,229,0.16));
    opacity: 0;
    animation: contactFloatUp var(--duration) linear infinite;
    animation-delay: var(--delay);
  }

  @keyframes contactFloatUp {
    0% { transform: translateY(0) scale(0); opacity: 0; }
    10% { opacity: 1; transform: translateY(-10px) scale(1); }
    90% { opacity: 1; transform: translateY(calc(var(--distance) - 10px)) scale(1); }
    100% { transform: translateY(var(--distance)) scale(0); opacity: 0; }
  }

  .contact-copy {
    position: relative;
    z-index: 10;
  }

  .contact-lead {
    margin: 1rem 0 0;
    max-width: 28rem;
    font-size: 1rem;
  }

  .contact-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.25rem 0 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
    position: relative;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  .eyebrow-wrapper { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .dot { width: 8px; height: 8px; background: var(--primary); border-radius: 50%; }
  .grad { background: linear-gradient(135deg, var(--primary), #ec4899); -webkit-background-clip: text; color: transparent; }

  .contact-links { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2rem; }
  .contact-form {
    padding: 0;
    overflow: hidden;
    position: relative;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface) 96%, transparent), color-mix(in srgb, var(--bg-alt) 82%, transparent));
    border-radius: 24px;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
    box-shadow: 0 18px 40px -24px color-mix(in srgb, var(--accent) 30%, transparent);
    backdrop-filter: blur(20px);
  }

  .form-intro {
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  }

  .form-intro p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .form-kicker {
    display: inline-block;
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--primary) 74%, var(--text-muted));
    letter-spacing: 0.1em;
    margin-bottom: 0.45rem;
  }

  .hover-glow {
    position: absolute; inset: 0; z-index: 1;
    background: radial-gradient(400px circle at var(--hx, 50%) var(--hy, 50%), color-mix(in srgb, var(--accent) 24%, transparent), transparent 50%);
    opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
  }
  .track-cursor:hover .hover-glow { opacity: 1; }

  .contact-topline {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 35%, transparent), transparent);
    z-index: 2;
    opacity: 0.95;
  }

  .form-fields { position: relative; z-index: 3; padding: 1.8rem 1.9rem 1.9rem; }
  .contact-form .editor-chrome { position: relative; z-index: 3; }

  .field-float input,
  .field-float textarea {
    width: 100%;
    background: color-mix(in srgb, var(--bg-alt) 50%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    border-radius: 16px;
    color: var(--text);
    padding: 1rem 1rem 0.95rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .field-float textarea {
    min-height: 8.5rem;
    resize: vertical;
  }

  .field-float label {
    left: 1rem;
  }

  .field-float input:focus,
  .field-float textarea:focus {
    border-color: color-mix(in srgb, var(--primary) 60%, var(--border));
    box-shadow: 0 0 0 4px var(--primary-dim);
    background: color-mix(in srgb, var(--surface) 90%, var(--bg-alt));
  }

  @media (max-width: 780px) {
    .contact-shell {
      padding: 1rem;
      border-radius: 24px;
    }

    .contact-grid { grid-template-columns: 1fr; padding: 1rem; }

    .form-fields {
      padding: 1.4rem 1.2rem 1.25rem;
    }
  }
</style>

<script is:inline>
  (() => {
  const form = document.querySelector("[data-contact-form]");
  if (!form) return;

  const sparklesContainer = document.getElementById("contact-sparkles");

  if (sparklesContainer && window.innerWidth > 768) {
    const particleCount = 16;
    for (let i = 0; i < particleCount; i++) {
      const sparkle = document.createElement("div");
      sparkle.classList.add("contact-sparkle");

      const size = Math.random() * 3 + 1;
      const left = Math.random() * 100;
      const duration = Math.random() * 10 + 10;
      const delay = Math.random() * -20;
      const distance = (Math.random() * 50 + 50) * -1;

      sparkle.style.width = `${size}px`;
      sparkle.style.height = `${size}px`;
      sparkle.style.left = `${left}%`;
      sparkle.style.bottom = `${Math.random() * 20 - 10}%`;
      sparkle.style.setProperty("--duration", `${duration}s`);
      sparkle.style.setProperty("--delay", `${delay}s`);
      sparkle.style.setProperty("--distance", `${distance}vh`);

      sparklesContainer.appendChild(sparkle);
    }
  }

  function messageFor(field) {
    if (field.validity.valueMissing) return "This field is required.";
    if (field.validity.typeMismatch) return "Enter a valid email address.";
    if (field.validity.tooShort) return `Enter at least ${field.minLength} characters.`;
    return "";
  }

  function validateField(field) {
    const errorEl = form.querySelector(`[data-error-for="${field.name}"]`);
    if (!errorEl) return true;
    errorEl.textContent = field.validity.valid ? "" : messageFor(field);
    return field.validity.valid;
  }

  form.querySelectorAll("[data-validate]").forEach(field => {
    field.addEventListener("blur", () => validateField(field));
    field.addEventListener("input", () => { if (field.dataset.touched) validateField(field); field.dataset.touched = "1"; });
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const fields = Array.from(form.querySelectorAll("[data-validate]"));
    const allValid = fields.map(validateField).every(Boolean);
    if (!allValid) {
      fields.find(f => !f.validity.valid)?.focus();
      return;
    }
    const label = form.querySelector("[data-btn-label]");
    const original = label.textContent;
    label.textContent = "Sent — thank you!";
    fields.forEach(f => f.disabled = true);
    setTimeout(() => {
      label.textContent = original;
      fields.forEach(f => { f.disabled = false; f.dataset.touched = ""; });
      form.reset();
      form.querySelectorAll(".field-error").forEach(el => el.textContent = "");
    }, 2500);
  });
  })();
</script>

<script is:inline>
  (() => {
  const revealEls = document.querySelectorAll("[data-reveal]");
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add("is-visible");
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  revealEls.forEach(el => revealObserver.observe(el));

  if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    document.querySelectorAll("[data-magnetic]").forEach(btn => {
      btn.addEventListener("mousemove", (e) => {
        const r = btn.getBoundingClientRect();
        const x = e.clientX - r.left - r.width / 2;
        const y = e.clientY - r.top - r.height / 2;
        btn.style.transform = `translate(${x * 0.25}px, ${y * 0.35}px)`;
      });
      btn.addEventListener("mouseleave", () => { btn.style.transform = "translate(0,0)"; });
    });
  }
  })();
</script>