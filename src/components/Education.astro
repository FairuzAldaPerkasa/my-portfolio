---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
---
<section id="education" class="section education">
  <div class="education-sparkles" id="education-sparkles" aria-hidden="true"></div>
  <div class="education-noise" aria-hidden="true"></div>
  <div class="education-grid-bg" aria-hidden="true"></div>
  <div class="education-aurora-container" aria-hidden="true">
    <div class="education-aurora education-aurora-1"></div>
    <div class="education-aurora education-aurora-2"></div>
    <div class="education-aurora education-aurora-3"></div>
  </div>
  <div class="education-spotlight" id="education-spot" aria-hidden="true"></div>

  <div class="education-container">
    <div class="section-head education-head reveal" data-reveal>
      <div class="eyebrow-wrapper">
        <span class="dot"></span>
        <p class="eyebrow mono">05_EDUCATION</p>
      </div>
      <h2>Education</h2>
      <p class="subtitle">Academic background and the focus areas that shaped how I build.</p>
    </div>

    <article class="card edu-card reveal track-cursor" data-reveal data-tilt data-glow style="--d:0.1s; --accent: var(--teal);">
      <div class="hover-glow"></div>
      <div class="edu-topline" aria-hidden="true"></div>
      <div class="editor-chrome">
        <span></span><span></span><span></span>
        <span class="file-name">education.md</span>
      </div>
      <div class="edu-body">
        <div class="edu-header">
          <div class="edu-header-main">
              <Image src={logo} alt="Logo Universitas Ahmad Dahlan" class="edu-logo" loading="lazy" />
            <div>
              <span class="edu-kicker mono">ACADEMIC PROFILE</span>
              <h3>Universitas Ahmad Dahlan</h3>
            </div>
          </div>
          <span class="edu-index mono">01</span>
        </div>
        <div class="edu-meta-row">
          <p class="chip chip-teal edu-degree">S1 Informatika — IPK 3.94/4.00</p>
          <span class="edu-date mono">2022-2026</span>
        </div>
        <div class="edu-tags">
          <span class="chip chip-indigo">Artificial Intelligence</span>
          <span class="chip chip-coral">Machine Learning</span>
          <span class="chip chip-teal">Data Science</span>
          <span class="chip chip-indigo">Web Development</span>
        </div>
        <p class="text-muted">
          Bantul, D.I. Yogyakarta. Mengerjakan proyek akademik berbasis data dan machine
          learning menggunakan Python, TensorFlow, Scikit-learn, dan SQL untuk menyelesaikan
          permasalahan nyata, serta berkolaborasi dalam proyek tim lintas mata kuliah termasuk
          penyusunan dokumentasi teknis dan presentasi hasil.
        </p>
      </div>
    </article>
  </div>
</section>

<style>
  .education {
    position: relative;
    width: 100%;
    padding: 4.5rem 0;
    background-color: var(--bg-base, var(--bg));
    overflow: hidden;
  }

  .education-container {
    width: 100%;
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 10;
    box-sizing: border-box;
  }

  .education-noise {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: var(--noise-op, 0.03);
    mix-blend-mode: overlay;
  }

  .education-sparkles {
    position: absolute;
    inset: 0;
    z-index: 4;
    overflow: hidden;
    pointer-events: none;
  }

  :global(.education-sparkle) {
    position: absolute;
    border-radius: 50%;
    background-color: var(--sparkle-color, rgba(6, 214, 160, 0.16));
    box-shadow: 0 0 10px 1px var(--sparkle-color, rgba(6, 214, 160, 0.16));
    opacity: 0;
    animation: educationFloatUp var(--duration) linear infinite;
    animation-delay: var(--delay);
  }

  @keyframes educationFloatUp {
    0% { transform: translateY(0) scale(0); opacity: 0; }
    10% { opacity: 1; transform: translateY(-10px) scale(1); }
    90% { opacity: 1; transform: translateY(calc(var(--distance) - 10px)) scale(1); }
    100% { transform: translateY(var(--distance)) scale(0); opacity: 0; }
  }

  .education-grid-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image: linear-gradient(to right, var(--grid-color, rgba(28,25,23,0.05)) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-color, rgba(28,25,23,0.05)) 1px, transparent 1px);
    background-size: 3rem 3rem;
    mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 80%);
  }

  .education-aurora-container {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .education-aurora {
    position: absolute;
    width: 45vw;
    height: 45vh;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.68;
    animation: educationAuroraMove 15s ease-in-out infinite alternate;
  }

  .education-aurora-1 {
    top: 0;
    left: 8%;
    background: radial-gradient(circle, rgba(79, 70, 229, 0.14) 0%, transparent 70%);
  }

  .education-aurora-2 {
    bottom: 5%;
    right: 8%;
    background: radial-gradient(circle, rgba(255, 107, 107, 0.12) 0%, transparent 70%);
    animation-delay: -5s;
  }

  .education-aurora-3 {
    top: 35%;
    left: 38%;
    width: 36vw;
    background: radial-gradient(circle, color-mix(in srgb, var(--teal) 12%, transparent) 0%, transparent 70%);
    animation-delay: -10s;
  }

  @keyframes educationAuroraMove {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(8%, 8%) scale(1.15); }
  }

  .education-spotlight {
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background: radial-gradient(800px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--teal) 6%, transparent), transparent 40%);
  }

  .education-head {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2.25rem;
    position: relative;
    z-index: 10;
  }

  .eyebrow-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    background: var(--primary);
    border-radius: 50%;
  }

  .education-head h2 {
    margin: 0;
  }

  .edu-card {
    position: relative;
    max-width: 42rem;
    margin: 0 auto;
    padding: 0;
    overflow: hidden;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface) 96%, transparent), color-mix(in srgb, var(--bg-alt) 82%, transparent));
    backdrop-filter: blur(20px);
    border-radius: 24px;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
  }

  .hover-glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(400px circle at var(--hx, 50%) var(--hy, 50%), color-mix(in srgb, var(--accent) 24%, transparent), transparent 50%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .track-cursor:hover .hover-glow {
    opacity: 1;
  }

  .edu-topline {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 35%, transparent), transparent);
    z-index: 2;
    opacity: 0.95;
  }

  .edu-body {
    position: relative;
    z-index: 3;
    padding: 1.35rem 1.5rem;
  }

  .edu-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.55rem;
  }

  .edu-header-main {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .edu-logo {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    padding: 0.3rem;
    flex-shrink: 0;
  }

  .edu-kicker {
    display: inline-block;
    color: var(--text-muted);
    font-size: 0.78rem;
    margin-bottom: 0.35rem;
  }

  .edu-body h3 {
    font-weight: 600;
    font-size: 1.2rem;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .edu-index {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .edu-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.55rem;
  }

  .edu-degree {
    margin: 0;
  }

  .edu-date {
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent) 70%, var(--text-muted));
  }

  .edu-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.15rem 0 0.7rem;
  }

  @media (max-width: 640px) {
    .education-container {
      padding: 0 1.25rem;
    }

    .edu-body {
      padding: 1.35rem;
    }

    .edu-meta-row {
      gap: 0.5rem;
    }
  }

  /* Compact mobile */
  @media (max-width: 640px) {
    .education { padding: 3rem 0; }
    .education-container { padding: 0 1rem; }
    .education-head { margin: 0 auto 1.75rem; }
    #education h2 { font-size: 1.5rem; }
    #education .eyebrow { font-size: 0.62rem; }
    #education .subtitle { font-size: 0.8rem; }
    .edu-card { border-radius: 18px; }
    .edu-body { padding: 0.85rem; }
    .edu-header { gap: 0.6rem; margin-bottom: 0.5rem; }
    .edu-header-main { gap: 0.5rem; }
    .edu-logo { width: 2rem; height: 2rem; }
    .edu-body h3 { font-size: 0.92rem; }
    .edu-kicker { font-size: 0.65rem; margin-bottom: 0.2rem; }
    .edu-index { font-size: 0.7rem; }
    .edu-meta-row { gap: 0.4rem; margin-bottom: 0.5rem; }
    .edu-date { font-size: 0.66rem; }
    .edu-tags { gap: 0.3rem; margin: 0.1rem 0 0.6rem; }
  }
</style>

<script is:inline>
  (() => {
    const section = document.querySelector("#education.education");
    const spotlight = document.getElementById("education-spot");
    const sparklesContainer = document.getElementById("education-sparkles");

    if (section && spotlight) {
      section.addEventListener("mousemove", (e) => {
        const rect = section.getBoundingClientRect();
        spotlight.style.setProperty("--mx", `${e.clientX - rect.left}px`);
        spotlight.style.setProperty("--my", `${e.clientY - rect.top}px`);

        document.querySelectorAll("#education .track-cursor").forEach((card) => {
          const cardRect = card.getBoundingClientRect();
          card.style.setProperty("--hx", `${e.clientX - cardRect.left}px`);
          card.style.setProperty("--hy", `${e.clientY - cardRect.top}px`);
        });
      });
    }


    // Lightweight canvas-based sparkle renderer (replaces per-particle DOM nodes for perf)
    function mountSparkleCanvas(container, count, fallbackColor) {
      const canvas = document.createElement("canvas");
      canvas.style.cssText = "position:absolute;inset:0;width:100%;height:100%;display:block;";
      container.appendChild(canvas);
      const ctx = canvas.getContext("2d");
      const color = (getComputedStyle(container).getPropertyValue("--sparkle-color") || "").trim() || fallbackColor;
      let w = 0, h = 0, raf = null;
      const resize = () => { w = canvas.width = container.clientWidth; h = canvas.height = container.clientHeight; };
      resize();
      window.addEventListener("resize", resize);
      const particles = Array.from({ length: count }, () => ({
        x: Math.random() * 100,
        y: Math.random() * 120 - 10,
        r: Math.random() * 1.5 + 0.5,
        speed: Math.random() * 0.012 + 0.006,
        drift: (Math.random() - 0.5) * 0.015,
        phase: Math.random() * Math.PI * 2,
      }));
      function draw() {
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = color;
        for (const p of particles) {
          p.y -= p.speed;
          p.x += p.drift;
          if (p.y < -10) { p.y = 110; p.x = Math.random() * 100; }
          const alpha = 0.35 + 0.65 * Math.pow(Math.sin(p.phase + p.y * 0.05), 2);
          ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
          ctx.beginPath();
          ctx.arc((p.x / 100) * w, (p.y / 100) * h, p.r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
        raf = requestAnimationFrame(draw);
      }
      draw();
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) { if (raf) cancelAnimationFrame(raf); raf = null; }
        else if (!raf) draw();
      });
    }

    if (sparklesContainer && window.innerWidth > 768) {
      // Perf: single <canvas> + rAF loop instead of 16 individual DOM nodes/animations
      mountSparkleCanvas(sparklesContainer, 16, "rgba(6,214,160,0.16)");
    }

    const revealEls = document.querySelectorAll("#education [data-reveal]");
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    revealEls.forEach((el) => revealObserver.observe(el));

    if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches && window.innerWidth > 900) {
      document.querySelectorAll("#education [data-tilt]").forEach((card) => {
        let rafId = null;
        card.addEventListener("mousemove", (e) => {
          const rect = card.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width - 0.5;
          const py = (e.clientY - rect.top) / rect.height - 0.5;
          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => {
            card.style.transform = `perspective(1000px) rotateY(${px * 6}deg) rotateX(${-py * 6}deg) translateY(-4px)`;
          });
        });
        card.addEventListener("mouseleave", () => {
          if (rafId) cancelAnimationFrame(rafId);
          card.style.transform = "perspective(1000px) rotateY(0deg) rotateX(0deg) translateY(0)";
        });
      });
    }

  })();
</script>