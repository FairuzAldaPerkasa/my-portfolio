---
import { getCollection, render } from "astro:content";
const jobs = await getCollection("experience");
const renderedJobs = await Promise.all(
  jobs.map(async (job) => ({
    job,
    Content: (await render(job)).Content,
  })),
);

function hashFor(i: number) {
  return (i.toString(16).padStart(2, "0") + "a1c9f3").slice(0, 7);
}
---
<section id="experience" class="section experience">
  <div class="experience-sparkles" id="experience-sparkles" aria-hidden="true"></div>
  <div class="experience-noise" aria-hidden="true"></div>
  <div class="experience-grid-bg" aria-hidden="true"></div>
  <div class="experience-aurora-container" aria-hidden="true">
    <div class="experience-aurora experience-aurora-1"></div>
    <div class="experience-aurora experience-aurora-2"></div>
    <div class="experience-aurora experience-aurora-3"></div>
  </div>
  <div class="experience-spotlight" id="experience-spot" aria-hidden="true"></div>

  <div class="experience-container">
    <div class="section-head experience-head reveal" data-reveal>
      <div class="eyebrow-wrapper">
        <span class="dot"></span>
        <p class="eyebrow mono">04_EXPERIENCE</p>
      </div>
      <h2>Where I've <span class="grad">worked</span></h2>
      <p class="subtitle">A log of roles, responsibilities, and the outcomes shipped along the way.</p>
    </div>

    <div class="experience-track" id="exp-beam">
      <div class="tracing-track"><div class="tracing-fill" id="exp-fill"></div></div>
      {renderedJobs.map(({ job, Content }, i) => (
        <article class="card experience-card open reveal track-cursor" data-reveal data-tilt data-timeline-item style={`--d:${i * 0.08}s; --accent: var(--${i % 2 === 0 ? "primary" : "coral"});`}>
          <div class="hover-glow"></div>
          <div class="experience-topline" aria-hidden="true"></div>
          <div class="editor-chrome">
            <span></span><span></span><span></span>
            <span class="file-name">experience-{hashFor(i)}.md</span>
          </div>
          <div class="experience-body">
            <div class="experience-header" data-timeline-toggle role="button" tabindex="0" aria-expanded="true">
              <div>
                <div class="timeline-kicker-row">
                  <span class="timeline-hash mono">#{hashFor(i)}</span>
                  <span class="timeline-lens" aria-hidden="true"></span>
                </div>
                <h3 class="timeline-role">{job.data.position}</h3>
              </div>
              <span class="timeline-toggle-icon" aria-hidden="true">+</span>
            </div>

            <div class="experience-meta">
              <span class="timeline-company chip chip-indigo">{job.data.company}</span>
              <span class="timeline-duration mono">{job.data.duration}</span>
              <span class="timeline-ambient mono">ROLE {i + 1}</span>
            </div>

            <div class="experience-content timeline-body">
              <div class="timeline-body-inner">
                <p class="text-muted">{job.data.description}</p>
                {Content && (
                  <div class="experience-markdown">
                    <Content />
                  </div>
                )}
                <ul class="timeline-achievements">
                  {job.data.achievements.map(a => <li>{a}</li>)}
                </ul>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experience {
    position: relative;
    width: 100%;
    padding: 4.5rem 0;
    background-color: var(--bg-base, var(--bg));
    overflow: hidden;
  }

  .experience-container {
    width: 100%;
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 10;
    box-sizing: border-box;
  }

  .experience-noise {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: var(--noise-op, 0.03);
    mix-blend-mode: overlay;
  }

  .experience-sparkles {
    position: absolute;
    inset: 0;
    z-index: 4;
    overflow: hidden;
    pointer-events: none;
  }

  :global(.experience-sparkle) {
    position: absolute;
    border-radius: 50%;
    background-color: var(--sparkle-color, rgba(79, 70, 229, 0.16));
    box-shadow: 0 0 10px 1px var(--sparkle-color, rgba(79, 70, 229, 0.16));
    opacity: 0;
    animation: experienceFloatUp var(--duration) linear infinite;
    animation-delay: var(--delay);
  }

  @keyframes experienceFloatUp {
    0% { transform: translateY(0) scale(0); opacity: 0; }
    10% { opacity: 1; transform: translateY(-10px) scale(1); }
    90% { opacity: 1; transform: translateY(calc(var(--distance) - 10px)) scale(1); }
    100% { transform: translateY(var(--distance)) scale(0); opacity: 0; }
  }

  .experience-grid-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image: linear-gradient(to right, var(--grid-color, rgba(28,25,23,0.05)) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-color, rgba(28,25,23,0.05)) 1px, transparent 1px);
    background-size: 3rem 3rem;
    mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 80%);
  }

  .experience-aurora-container {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .experience-aurora {
    position: absolute;
    width: 45vw;
    height: 45vh;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.68;
    animation: experienceAuroraMove 15s ease-in-out infinite alternate;
  }

  .experience-aurora-1 {
    top: 0;
    left: 8%;
    background: radial-gradient(circle, rgba(79, 70, 229, 0.14) 0%, transparent 70%);
  }

  .experience-aurora-2 {
    bottom: 5%;
    right: 8%;
    background: radial-gradient(circle, rgba(255, 107, 107, 0.12) 0%, transparent 70%);
    animation-delay: -5s;
  }

  .experience-aurora-3 {
    top: 35%;
    left: 38%;
    width: 36vw;
    background: radial-gradient(circle, color-mix(in srgb, var(--teal) 12%, transparent) 0%, transparent 70%);
    animation-delay: -10s;
  }

  @keyframes experienceAuroraMove {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(8%, 8%) scale(1.15); }
  }

  .experience-spotlight {
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background: radial-gradient(800px circle at var(--mx, 50%) var(--my, 50%), rgba(79,70,229,0.05), transparent 40%);
  }

  .experience-head {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2.5rem;
    position: relative;
    z-index: 10;
  }

  .eyebrow-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    background: var(--primary);
    border-radius: 50%;
  }

  .grad {
    color: var(--primary);
  }

  .experience-track {
    position: relative;
    z-index: 10;
    display: grid;
    gap: 1rem;
  }

  .tracing-track {
    position: absolute;
    left: 1.3rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: color-mix(in srgb, var(--border) 50%, transparent);
    overflow: hidden;
  }

  .tracing-fill {
    width: 100%;
    height: 100%;
    transform: scaleY(0);
    transform-origin: top;
    background: linear-gradient(to bottom, var(--primary), var(--coral), var(--teal));
    box-shadow: 0 0 18px color-mix(in srgb, var(--primary) 40%, transparent);
    transition: transform 0.1s linear;
  }

  .experience-card {
    position: relative;
    margin-left: 2.8rem;
    width: calc(100% - 2.8rem);
    padding: 0;
    overflow: hidden;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface) 96%, transparent), color-mix(in srgb, var(--bg-alt) 80%, transparent));
    backdrop-filter: blur(20px);
    border-radius: 24px;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
  }

  .hover-glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(400px circle at var(--hx, 50%) var(--hy, 50%), color-mix(in srgb, var(--accent) 24%, transparent), transparent 50%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .track-cursor:hover .hover-glow {
    opacity: 1;
  }

  .experience-topline {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 35%, transparent), transparent);
    z-index: 2;
    opacity: 0.95;
  }

  .experience-body {
    position: relative;
    z-index: 3;
    padding: 0;
  }

  .experience-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.35rem 1.4rem 0.85rem;
    cursor: pointer;
  }

  .timeline-kicker-row {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.45rem;
  }

  .timeline-hash {
    display: inline-block;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--accent) 70%, var(--text-muted));
  }

  .timeline-lens {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 85%, white);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .timeline-role {
    font-size: clamp(1.2rem, 1.7vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .timeline-company {
    font-size: 0.75rem;
  }

  .timeline-toggle-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 18%, var(--surface)), color-mix(in srgb, var(--accent) 8%, var(--surface)));
    color: color-mix(in srgb, var(--accent) 70%, var(--text-muted));
    flex: 0 0 auto;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow: 0 8px 20px -14px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .experience-card.open .timeline-toggle-icon {
    transform: rotate(45deg);
  }

  .experience-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1.4rem 0.85rem;
  }

  .timeline-duration {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .timeline-ambient {
    margin-left: auto;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent) 65%, var(--text-muted));
  }

  .timeline-body {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 0.4s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .experience-card.open .timeline-body {
    grid-template-rows: 1fr;
  }

  .timeline-body-inner {
    min-height: 0;
    /* 70ch was rendering ~98 real characters/line in this font (the 'ch' unit is
       sized off the '0' glyph, which is wider than the average letter here).
       54ch keeps the actual measure under 80 characters/line. */
    max-width: 54ch;
    padding: 0 1.4rem 1.4rem;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.3s ease, transform 0.35s ease;
  }

  .experience-card.open .timeline-body-inner {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.4s ease 0.06s, transform 0.4s ease 0.06s;
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-body,
    .timeline-body-inner {
      transition: none;
    }
  }

  .experience-markdown {
    display: grid;
    gap: 0.9rem;
    margin-top: 1rem;
  }

  .experience-markdown :global(h2),
  .experience-markdown :global(h3),
  .experience-markdown :global(h4) {
    margin: 0;
    font-size: 1rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .experience-markdown :global(p) {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.75;
    font-size: 0.97rem;
  }

  .experience-markdown :global(ul),
  .experience-markdown :global(ol) {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--text-muted);
    display: grid;
    gap: 0.45rem;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .experience-markdown :global(li::marker) {
    color: var(--accent);
  }

  .experience-markdown :global(blockquote) {
    margin: 0.5rem 0;
    padding: 0.2rem 0 0.2rem 0.1rem;
    font-family: var(--font-display, 'Playfair Display', serif);
    font-style: italic;
    font-size: 1.05em;
    line-height: 1.5;
    color: var(--text);
    position: relative;
  }

  .experience-markdown :global(blockquote::before) {
    content: '\201C';
    font-family: var(--font-display, 'Playfair Display', serif);
    font-style: normal;
    font-size: 2.2em;
    line-height: 0;
    color: var(--accent);
    margin-right: 0.15rem;
    vertical-align: -0.35em;
    display: inline-block;
  }

  .experience-markdown :global(*) {
    word-break: break-word;
  }

  .experience-markdown :global(a) {
    color: var(--primary);
    text-decoration: none;
  }

  .experience-markdown :global(a:hover) {
    text-decoration: underline;
  }

  .timeline-achievements {
    color: var(--text-muted);
    font-size: 0.9rem;
    padding-left: 1.2rem;
    margin: 0.75rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 54ch;
  }

  .timeline-achievements li::marker {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .experience-container {
      padding: 0 1.25rem;
    }

    .experience-card {
      margin-left: 1.8rem;
    }

    .tracing-track {
      left: 0.85rem;
    }

    .experience-header,
    .experience-meta,
    .timeline-body {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .timeline-ambient {
      width: 100%;
      margin-left: 0;
    }

    .experience-card {
      width: calc(100% - 1.8rem);
    }

    .experience-markdown {
      gap: 0.75rem;
    }
  }

  /* Compact mobile */
  @media (max-width: 640px) {
    .experience { padding: 3rem 0; }
    .experience-container { padding: 0 0.75rem; }
    .experience-head { margin: 0 auto 1.75rem; }
    #experience h2 { font-size: 1.5rem; }
    #experience .eyebrow { font-size: 0.62rem; }
    #experience .subtitle { font-size: 0.8rem; }
    .experience-card { margin-left: 1.2rem; width: calc(100% - 1.2rem); border-radius: 16px; }
    .tracing-track { left: 0.55rem; }
    .experience-header {
      padding: 0.85rem 0.85rem 0.6rem;
      gap: 0.5rem;
    }
    .experience-header,
    .experience-meta,
    .timeline-body {
      padding-left: 0.85rem;
      padding-right: 0.85rem;
    }
    .timeline-kicker-row { gap: 0.4rem; margin-bottom: 0.3rem; }
    .timeline-hash { font-size: 0.68rem; }
    .timeline-role { font-size: 0.92rem; }
    .timeline-company { font-size: 0.64rem; }
    .timeline-toggle-icon { width: 1.4rem; height: 1.4rem; }
    .experience-meta { gap: 0.5rem; padding-bottom: 0.75rem; }
    .experience-markdown { gap: 0.55rem; margin-top: 0.75rem; }
    .experience-markdown :global(h2),
    .experience-markdown :global(h3),
    .experience-markdown :global(h4) { font-size: 0.85rem; }
    .experience-markdown :global(p) { font-size: 0.78rem; line-height: 1.55; }
    .experience-markdown :global(ul), .experience-markdown :global(ol) { font-size: 0.76rem; padding-left: 0.85rem; gap: 0.3rem; }
    .timeline-achievements { font-size: 0.78rem; padding-left: 0.85rem; gap: 0.25rem; }
  }
</style>

<script is:inline>
  (() => {
    const section = document.querySelector("#experience.experience");
    const spotlight = document.getElementById("experience-spot");
    const sparklesContainer = document.getElementById("experience-sparkles");

    if (section && spotlight) {
      section.addEventListener("mousemove", (e) => {
        const rect = section.getBoundingClientRect();
        spotlight.style.setProperty("--mx", `${e.clientX - rect.left}px`);
        spotlight.style.setProperty("--my", `${e.clientY - rect.top}px`);

        document.querySelectorAll("#experience .track-cursor").forEach((card) => {
          const cardRect = card.getBoundingClientRect();
          card.style.setProperty("--hx", `${e.clientX - cardRect.left}px`);
          card.style.setProperty("--hy", `${e.clientY - cardRect.top}px`);
        });
      });
    }


    // Lightweight canvas-based sparkle renderer (replaces per-particle DOM nodes for perf)
    function mountSparkleCanvas(container, count, fallbackColor) {
      const canvas = document.createElement("canvas");
      canvas.style.cssText = "position:absolute;inset:0;width:100%;height:100%;display:block;";
      container.appendChild(canvas);
      const ctx = canvas.getContext("2d");
      const color = (getComputedStyle(container).getPropertyValue("--sparkle-color") || "").trim() || fallbackColor;
      let w = 0, h = 0, raf = null;
      const resize = () => { w = canvas.width = container.clientWidth; h = canvas.height = container.clientHeight; };
      resize();
      window.addEventListener("resize", resize);
      const particles = Array.from({ length: count }, () => ({
        x: Math.random() * 100,
        y: Math.random() * 120 - 10,
        r: Math.random() * 1.5 + 0.5,
        speed: Math.random() * 0.012 + 0.006,
        drift: (Math.random() - 0.5) * 0.015,
        phase: Math.random() * Math.PI * 2,
      }));
      function draw() {
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = color;
        for (const p of particles) {
          p.y -= p.speed;
          p.x += p.drift;
          if (p.y < -10) { p.y = 110; p.x = Math.random() * 100; }
          const alpha = 0.35 + 0.65 * Math.pow(Math.sin(p.phase + p.y * 0.05), 2);
          ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
          ctx.beginPath();
          ctx.arc((p.x / 100) * w, (p.y / 100) * h, p.r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
        raf = requestAnimationFrame(draw);
      }
      draw();
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) { if (raf) cancelAnimationFrame(raf); raf = null; }
        else if (!raf) draw();
      });
    }

    if (sparklesContainer && window.innerWidth > 768) {
      // Perf: single <canvas> + rAF loop instead of 16 individual DOM nodes/animations
      mountSparkleCanvas(sparklesContainer, 16, "rgba(79,70,229,0.16)");
    }

    document.querySelectorAll("[data-timeline-toggle]").forEach((header) => {
      const item = header.closest("[data-timeline-item]");
      const body = item.querySelector(".timeline-body");
      if (!body) return;

      // On mobile layouts, accordions should start collapsed regardless of the
      // markup's default "open" state.
      if (window.innerWidth <= 768 && item.classList.contains("open")) {
        item.classList.remove("open");
        header.setAttribute("aria-expanded", "false");
      }

      // Height animation is handled purely in CSS via grid-template-rows,
      // so toggling just needs to flip the class + aria state.
      function toggle() {
        const willOpen = !item.classList.contains("open");
        item.classList.toggle("open", willOpen);
        header.setAttribute("aria-expanded", String(willOpen));
      }

      header.addEventListener("click", toggle);
      header.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggle();
        }
      });
    });

    const revealEls = document.querySelectorAll("#experience [data-reveal]");
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    revealEls.forEach((el) => revealObserver.observe(el));

    if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches && window.innerWidth > 900) {
      document.querySelectorAll("#experience [data-tilt]").forEach((card) => {
        let rafId = null;
        card.addEventListener("mousemove", (e) => {
          const rect = card.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width - 0.5;
          const py = (e.clientY - rect.top) / rect.height - 0.5;
          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => {
            card.style.transform = `perspective(1000px) rotateY(${px * 6}deg) rotateX(${-py * 6}deg) translateY(-4px)`;
          });
        });
        card.addEventListener("mouseleave", () => {
          if (rafId) cancelAnimationFrame(rafId);
          card.style.transform = "perspective(1000px) rotateY(0deg) rotateX(0deg) translateY(0)";
        });
      });
    }

    const beam = document.getElementById("exp-beam");
    const fill = document.getElementById("exp-fill");
    if (!beam || !fill) return;

    function updateBeam() {
      const r = beam.getBoundingClientRect();
      const vh = window.innerHeight;
      const total = r.height;
      const progressed = Math.min(Math.max(vh * 0.75 - r.top, 0), total);
      fill.style.transform = `scaleY(${total ? progressed / total : 0})`;
    }

    document.addEventListener("scroll", updateBeam, { passive: true });
    window.addEventListener("resize", updateBeam);
    updateBeam();
  })();
</script>