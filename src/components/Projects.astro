---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
const allProjects = await getCollection("projects");
const colors = ["indigo", "coral", "teal", "pink", "sunshine"];

const projectsSorted = [...allProjects].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<section id="projects" class="section projects">
  <div class="projects-sparkles" id="projects-sparkles" aria-hidden="true"></div>
  <div class="projects-noise" aria-hidden="true"></div>
  <div class="projects-grid-bg" aria-hidden="true"></div>
  <div class="projects-aurora-container" aria-hidden="true">
    <div class="projects-aurora projects-aurora-1"></div>
    <div class="projects-aurora projects-aurora-2"></div>
    <div class="projects-aurora projects-aurora-3"></div>
  </div>
  <div class="projects-spotlight" id="projects-spot" aria-hidden="true"></div>

  <div class="projects-container">
    <div class="section-head projects-head reveal" data-reveal>
      <div class="eyebrow-wrapper">
        <span class="dot"></span>
        <p class="eyebrow mono">03_PROJECTS</p>
      </div>
      <h2>Featured <span class="grad">work</span></h2>
      <p class="subtitle">A selection of things I've built — problems solved, systems shipped, and outcomes measured.</p>
    </div>

    <div class="projects-grid">
      {projectsSorted.map((project, i) => (
        <article class="card project-card reveal track-cursor project-panel" data-reveal data-tilt data-glow style={`--d:${i * 0.06}s; --accent: var(--${colors[i % colors.length]});`}>
          <div class="hover-glow"></div>
          <div class="project-topline" aria-hidden="true"></div>
          
          <!-- Header Chrome -->
          <div class="editor-chrome">
            <span></span><span></span><span></span>
            <span class="file-name">{project.data.title?.toLowerCase().replace(/\s+/g, "-")}.tsx</span>
          </div>

          <button class="project-preview" data-project-open
            data-title={project.data.title} 
            data-role={project.data.role}
            data-date={project.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short" })}
            data-desc={project.data.description} 
            data-problem={project.data.problem}
            data-impact={project.data.impact}
            data-tech={JSON.stringify(project.data.tech || [])}
            data-github={project.data.githubUrl ?? ""} 
            data-demo={project.data.demoUrl ?? ""}
            data-image={project.data.image?.src ?? ""}
            aria-label={`View full details of ${project.data.title}`}>
            {project.data.image ? (
              <Image src={project.data.image} alt={project.data.title} class="project-thumb" loading="lazy" />
            ) : (
              <span class="project-icon" aria-hidden="true">💻</span>
            )}
            <span class="mono project-preview-label">View Details</span>
          </button>

          <!-- Card Body (Summary Only) -->
          <div class="project-body">
            <div class="project-kicker-row">
              <span class="project-index mono">0{i + 1}</span>
            </div>
            <h3>{project.data.title}</h3>
            <p class="project-role">{project.data.role}</p>
            <p class="text-muted project-desc project-desc-summary">{project.data.description}</p>
            <p class="project-date mono">{project.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short" })}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Modal (Full Information) -->
<div class="modal-backdrop" id="project-modal">
  <div class="modal-box">
    <button class="modal-close" id="project-modal-close" aria-label="Close preview">✕</button>
    <img id="project-modal-image" class="project-modal-thumb" alt="" style="display:none;" />
    <span class="project-icon" id="project-modal-icon" style="font-size:2.5rem;" aria-hidden="true">💻</span>
    <h3 id="project-modal-title" style="margin-top:0.75rem;"></h3>
    <p class="project-role" id="project-modal-role" style="margin:0.5rem 0 0;"></p>
    <p class="project-date mono" id="project-modal-date" style="margin:0.5rem 0 0.85rem;"></p>
    
    <div class="chip-row" id="project-modal-tech"></div>
    
    <p class="text-muted" id="project-modal-desc" style="margin-top: 1rem;"></p>
    
    <div id="project-modal-impact-section" style="margin-top: 1.25rem;">
      <p class="impact-line" id="problem-container"><strong>Problem —</strong> <span class="text-muted" id="project-modal-problem"></span></p>
      <p class="impact-line" id="impact-container"><strong>Impact —</strong> <span class="text-muted" id="project-modal-impact"></span></p>
    </div>

    <div class="project-links" id="project-modal-links" style="margin-top:1.5rem;">
      <a href="#" target="_blank" rel="noopener" id="project-modal-github">GitHub ↗</a>
      <a href="#" target="_blank" rel="noopener" id="project-modal-demo">Live Demo ↗</a>
    </div>
  </div>
</div>

<style>
  .projects {
    position: relative;
    width: 100%;
    padding: 7rem 0;
    background-color: var(--bg-base, var(--bg));
    overflow: hidden;
  }

  .projects-container {
    width: 100%;
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 10;
    box-sizing: border-box;
  }

  .projects-noise {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: var(--noise-op, 0.03);
    mix-blend-mode: overlay;
  }

  .projects-sparkles {
    position: absolute;
    inset: 0;
    z-index: 4;
    overflow: hidden;
    pointer-events: none;
  }

  :global(.projects-sparkle) {
    position: absolute;
    border-radius: 50%;
    background-color: var(--sparkle-color, rgba(79, 70, 229, 0.16));
    box-shadow: 0 0 10px 1px var(--sparkle-color, rgba(79, 70, 229, 0.16));
    opacity: 0;
    animation: projectsFloatUp var(--duration) linear infinite;
    animation-delay: var(--delay);
  }

  @keyframes projectsFloatUp {
    0% { transform: translateY(0) scale(0); opacity: 0; }
    10% { opacity: 1; transform: translateY(-10px) scale(1); }
    90% { opacity: 1; transform: translateY(calc(var(--distance) - 10px)) scale(1); }
    100% { transform: translateY(var(--distance)) scale(0); opacity: 0; }
  }

  .projects-grid-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image: linear-gradient(to right, var(--grid-color, rgba(15,23,42,0.05)) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-color, rgba(15,23,42,0.05)) 1px, transparent 1px);
    background-size: 3rem 3rem;
    mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 80%);
  }

  .projects-aurora-container {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .projects-aurora {
    position: absolute;
    width: 45vw;
    height: 45vh;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.68;
    animation: projectsAuroraMove 15s ease-in-out infinite alternate;
  }

  .projects-aurora-1 {
    top: 0;
    left: 8%;
    background: radial-gradient(circle, rgba(79, 70, 229, 0.14) 0%, transparent 70%);
  }

  .projects-aurora-2 {
    bottom: 5%;
    right: 8%;
    background: radial-gradient(circle, rgba(255, 107, 107, 0.12) 0%, transparent 70%);
    animation-delay: -5s;
  }

  .projects-aurora-3 {
    top: 35%;
    left: 38%;
    width: 36vw;
    background: radial-gradient(circle, rgba(6, 214, 160, 0.12) 0%, transparent 70%);
    animation-delay: -10s;
  }

  @keyframes projectsAuroraMove {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(8%, 8%) scale(1.15); }
  }

  .projects-spotlight {
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background: radial-gradient(800px circle at var(--mx, 50%) var(--my, 50%), rgba(79,70,229,0.05), transparent 40%);
  }

  .projects-head {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 5rem;
    position: relative;
    z-index: 10;
  }

  .eyebrow-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    background: var(--primary);
    border-radius: 50%;
  }

  .grad {
    background: linear-gradient(135deg, var(--primary), #ec4899);
    -webkit-background-clip: text;
    color: transparent;
  }

  .projects-grid {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.75rem;
  }

  .project-panel {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface) 96%, transparent), color-mix(in srgb, var(--bg-alt) 82%, transparent));
    backdrop-filter: blur(20px);
    border-radius: 24px;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
    box-shadow: 0 18px 40px -24px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .hover-glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(400px circle at var(--hx, 50%) var(--my, 50%), color-mix(in srgb, var(--accent) 24%, transparent), transparent 50%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .track-cursor:hover .hover-glow { opacity: 1; }

  .project-topline {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 35%, transparent), transparent);
    z-index: 2;
    opacity: 0.95;
  }

  .editor-chrome {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem 1.5rem 1rem; 
    width: 100%;
    box-sizing: border-box;
  }

  .editor-chrome > span:not(.file-name) {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .editor-chrome > span:nth-child(1) { background-color: #ff5f56; }
  .editor-chrome > span:nth-child(2) { background-color: #ffbd2e; }
  .editor-chrome > span:nth-child(3) { background-color: #27c93f; }

  .editor-chrome .file-name {
    flex: 1 1 auto;
    min-width: 0;
    white-space: nowrap; 
    font-size: 0.85rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.5; 
    padding-bottom: 2px;
    margin-left: 0.5rem;
  }

  #project-modal .modal-box {
    max-height: 90vh;
    overflow-y: auto;
  }

  .project-card {
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .project-body {
    position: relative;
    z-index: 3;
    padding: 0 1.5rem 1.5rem;
  }

  .project-kicker-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .project-index {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .project-date {
    margin: 0.8rem 0 0;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent) 70%, var(--text-muted));
  }

  .project-body h3 {
    font-weight: 600;
    font-size: 1.08rem;
    line-height: 1.25;
    margin: 0;
  }

  .project-role {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0.4rem 0 0;
    padding-left: 0.65rem;
    border-left: 2px solid color-mix(in srgb, var(--accent) 55%, var(--border));
  }

  .project-desc {
    font-size: 0.9rem;
    line-height: 1.65;
    margin: 0.5rem 0 0;
  }

  /* Ringkasan teks di card */
  .project-desc-summary {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .project-links a {
    text-decoration: none;
    color: var(--primary);
  }

  .project-links a:hover {
    text-decoration: underline;
  }

  .impact-line {
    font-size: 0.85rem;
    line-height: 1.55;
    margin: 0.5rem 0 0;
  }

  .project-preview {
    width: 100%;
    background: linear-gradient(180deg, color-mix(in srgb, var(--bg-alt) 88%, transparent), color-mix(in srgb, var(--surface) 95%, transparent));
    border: 1px dashed color-mix(in srgb, var(--accent) 26%, var(--border));
    border-radius: 18px;
    padding: 1.35rem 1.5rem;
    margin: 0 1.5rem 1rem;
    width: calc(100% - 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    overflow: hidden;
    cursor: pointer;
    font: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .project-preview:hover,
  .track-cursor:hover .project-preview {
    border-color: var(--accent);
    transform: translateY(-2px) scale(1.01);
    box-shadow: 0 12px 24px -18px color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .project-icon {
    font-size: 1.8rem;
  }

  .project-thumb {
    width: 100%;
    height: 8rem;
    object-fit: cover;
    object-position: center;
    border-radius: 10px;
  }

  .project-preview-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-modal-thumb {
    max-width: 100%;
    max-height: min(55vh, 22rem);
    object-fit: contain;
    border-radius: 12px;
    margin: 0 auto;
    display: block;
  }

  @media (max-width: 640px) {
    .projects-container {
      padding: 0 1.25rem;
    }

    .project-body {
      padding: 0 1.25rem 1.25rem;
    }

    .project-preview {
      margin: 0 1.25rem 1rem;
      width: calc(100% - 2.5rem);
    }
  }
</style>

<script is:inline>
  (() => {
    const modal = document.getElementById("project-modal");
    const closeBtn = document.getElementById("project-modal-close");
    const titleEl = document.getElementById("project-modal-title");
    const roleEl = document.getElementById("project-modal-role");
    const dateEl = document.getElementById("project-modal-date");
    const descEl = document.getElementById("project-modal-desc");
    const techEl = document.getElementById("project-modal-tech");
    const problemEl = document.getElementById("project-modal-problem");
    const problemContainer = document.getElementById("problem-container");
    const impactEl = document.getElementById("project-modal-impact");
    const impactContainer = document.getElementById("impact-container");
    const githubEl = document.getElementById("project-modal-github");
    const demoEl = document.getElementById("project-modal-demo");
    const imageEl = document.getElementById("project-modal-image");
    const iconEl = document.getElementById("project-modal-icon");
    const section = document.querySelector("#projects.projects");
    const spotlight = document.getElementById("projects-spot");
    const sparklesContainer = document.getElementById("projects-sparkles");

    document.querySelectorAll("[data-project-open]").forEach((btn) => {
      btn.addEventListener("click", () => {
        titleEl.textContent = btn.dataset.title;
        roleEl.textContent = btn.dataset.role;
        dateEl.textContent = btn.dataset.date;
        descEl.textContent = btn.dataset.desc;

        // Render Tech Chips
        techEl.innerHTML = "";
        if (btn.dataset.tech) {
          try {
            const techs = JSON.parse(btn.dataset.tech);
            const colors = ["indigo", "coral", "teal", "pink", "sunshine"];
            techs.forEach((t, index) => {
              const span = document.createElement("span");
              span.className = `chip chip-${colors[index % colors.length]}`;
              span.textContent = t;
              techEl.appendChild(span);
            });
          } catch (e) {
            console.error("Gagal memproses data tech", e);
          }
        }

        // Render Problem
        if (btn.dataset.problem) {
          problemEl.textContent = btn.dataset.problem;
          problemContainer.style.display = "block";
        } else {
          problemContainer.style.display = "none";
        }

        // Render Impact
        if (btn.dataset.impact) {
          impactEl.textContent = btn.dataset.impact;
          impactContainer.style.display = "block";
        } else {
          impactContainer.style.display = "none";
        }

        // Render Links
        if (btn.dataset.github) {
          githubEl.href = btn.dataset.github;
          githubEl.style.display = "inline-flex";
        } else {
          githubEl.style.display = "none";
        }

        if (btn.dataset.demo) {
          demoEl.href = btn.dataset.demo;
          demoEl.style.display = "inline-flex";
        } else {
          demoEl.style.display = "none";
        }

        // Render Image
        if (btn.dataset.image) {
          imageEl.src = btn.dataset.image;
          imageEl.alt = btn.dataset.title;
          imageEl.style.display = "block";
          iconEl.style.display = "none";
        } else {
          imageEl.style.display = "none";
          iconEl.style.display = "inline";
        }

        modal.classList.add("open");
      });
    });

    function closeModal() { modal.classList.remove("open"); }
    closeBtn.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });

    if (section && spotlight) {
      section.addEventListener("mousemove", (e) => {
        const rect = section.getBoundingClientRect();
        spotlight.style.setProperty("--mx", `${e.clientX - rect.left}px`);
        spotlight.style.setProperty("--my", `${e.clientY - rect.top}px`);

        document.querySelectorAll("#projects .track-cursor").forEach((card) => {
          const cardRect = card.getBoundingClientRect();
          card.style.setProperty("--hx", `${e.clientX - cardRect.left}px`);
          card.style.setProperty("--hy", `${e.clientY - cardRect.top}px`);
        });
      });
    }

    if (sparklesContainer && window.innerWidth > 768) {
      const particleCount = 16;
      for (let i = 0; i < particleCount; i++) {
        const sparkle = document.createElement("div");
        sparkle.classList.add("projects-sparkle");

        const size = Math.random() * 3 + 1;
        const left = Math.random() * 100;
        const duration = Math.random() * 10 + 10;
        const delay = Math.random() * -20;
        const distance = (Math.random() * 50 + 50) * -1;

        sparkle.style.width = `${size}px`;
        sparkle.style.height = `${size}px`;
        sparkle.style.left = `${left}%`;
        sparkle.style.bottom = `${Math.random() * 20 - 10}%`;
        sparkle.style.setProperty("--duration", `${duration}s`);
        sparkle.style.setProperty("--delay", `${delay}s`);
        sparkle.style.setProperty("--distance", `${distance}vh`);

        sparklesContainer.appendChild(sparkle);
      }
    }

    const revealEls = document.querySelectorAll("#projects [data-reveal]");
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    revealEls.forEach((el) => revealObserver.observe(el));

    if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches && window.innerWidth > 900) {
      document.querySelectorAll("#projects [data-tilt]").forEach((card) => {
        let rafId = null;
        card.addEventListener("mousemove", (e) => {
          const rect = card.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width - 0.5;
          const py = (e.clientY - rect.top) / rect.height - 0.5;
          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => {
            card.style.transform = `perspective(1000px) rotateY(${px * 6}deg) rotateX(${-py * 6}deg) translateY(-4px)`;
          });
        });
        card.addEventListener("mouseleave", () => {
          if (rafId) cancelAnimationFrame(rafId);
          card.style.transform = "perspective(1000px) rotateY(0deg) rotateX(0deg) translateY(0)";
        });
      });
    }
  })();
</script>