---
import { getCollection } from "astro:content";
const projects = await getCollection("projects");
const colors = ["indigo", "coral", "teal", "pink"];
---
<section id="projects" class="section">
  <h2 style="font-size:2rem; margin-bottom:2.5rem;">Featured Projects</h2>
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:1.5rem;">
    {projects.map((project, i) => (
      <div class="card">
        <h3 style="font-size:1.25rem; font-weight:600;">{project.data.title}</h3>
        <p class="text-muted" style="margin:0.5rem 0;">{project.data.description}</p>
        <p style="font-size:0.85rem; margin-bottom:0.75rem;"><strong>Problem:</strong> <span class="text-muted">{project.data.problem}</span></p>
        <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.75rem;">
          {project.data.tech.map(t => <span class={`chip chip-${colors[i % colors.length]}`}>{t}</span>)}
        </div>
        <p style="font-size:0.85rem; margin-bottom:0.75rem;"><strong>Impact:</strong> <span class="text-muted">{project.data.impact}</span></p>
        <div style="display:flex; gap:1rem; font-size:0.85rem;">
          {project.data.githubUrl && <a href={project.data.githubUrl} target="_blank">GitHub</a>}
          {project.data.demoUrl && <a href={project.data.demoUrl} target="_blank">Live Demo</a>}
        </div>
      </div>
    ))}
  </div>
</section>