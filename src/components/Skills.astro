---
type SkillColor = "indigo" | "coral" | "sunshine" | "teal" | "pink";

const colorVarMap: Record<SkillColor, string> = {
  indigo: "primary",
  coral: "coral",
  sunshine: "sunshine",
  teal: "teal",
  pink: "pink",
};

const skillGroups: Array<{
  title: string;
  icon: string;
  desc: string;
  color: SkillColor;
  items: string[];
}> = [
  { title: "Programming Languages", icon: "⌘", desc: "Core languages I write daily.", color: "indigo",
    items: ["Python", "PHP", "JavaScript", "SQL", "HTML", "CSS"] },
  { title: "Frameworks & Library", icon: "◱", desc: "Tools for building web features fast.", color: "coral",
    items: ["CodeIgniter", "Bootstrap", "jQuery", "AJAX", "JSON"] },
  { title: "Machine Learning", icon: "◉", desc: "Modeling and deploying predictive systems.", color: "teal",
    items: ["TensorFlow", "Scikit-learn"] },
  { title: "Database", icon: "▤", desc: "Modeling and querying data at scale.", color: "pink",
    items: ["MySQL", "PostgreSQL"] },
  { title: "DevOps & Tools", icon: "⚙", desc: "Shipping and deploying with confidence.", color: "sunshine",
    items: ["Docker", "Git", "GitLab", "CI/CD"] },
  { title: "CS Fundamentals", icon: "▧", desc: "The foundation behind every system.", color: "indigo",
    items: ["Struktur Data", "Database Management", "Data Visualization"] },
  { title: "Soft Skills", icon: "◈", desc: "How I work with people, not just code.", color: "coral",
    items: ["Problem Solving", "Communication", "Teamwork", "Time Management", "Leadership", "Critical Thinking", "Research", "Self-Learning", "Adaptability", "Mentoring"]}
];

const totalSkills = skillGroups.reduce((sum, g) => sum + g.items.length, 0);
---

<section id="skills" class="section skills">
  <!-- Background Layers -->
  <div class="skills-sparkles" id="skills-sparkles" aria-hidden="true"></div>
  <div class="skills-noise" aria-hidden="true"></div>
  <div class="skills-grid-bg" aria-hidden="true"></div>
  <div class="skills-aurora-container" aria-hidden="true">
    <div class="skills-aurora skills-aurora-1"></div>
    <div class="skills-aurora skills-aurora-2"></div>
    <div class="skills-aurora skills-aurora-3"></div>
  </div>
  <div class="skills-spotlight" id="skills-spot" aria-hidden="true"></div>

  <!-- Content -->
  <div class="skills-container">
    <div class="section-head skills-head reveal" data-reveal>
      <div class="eyebrow-wrapper">
        <span class="dot"></span>
        <p class="eyebrow mono">02_SKILLS</p>
      </div>
      <h2>What I <span class="grad">work with</span></h2>
      <p class="subtitle">{totalSkills} tools across {skillGroups.length} categories — grouped by where I use them.</p>
    </div>

    <div class="skills-grid">
      {skillGroups.map((group, gi) => (
        <div
          class="glow-card skill-card reveal track-cursor"
          data-reveal
          data-glow
          data-tilt
          style={`--d:${gi * 0.05}s; --accent: var(--${colorVarMap[group.color]});`}
        >
          <div class="hover-glow"></div>
          <div class="skill-topline" aria-hidden="true"></div>
          <div class="skill-top">
            <div class="glow-card-icon skill-icon" aria-hidden="true">{group.icon}</div>
            <span class="skill-index mono">0{gi + 1}</span>
          </div>
          <h3 class="skill-card-title">{group.title}</h3>
          <p class="text-muted skill-card-desc">{group.desc}</p>
          <div class="skill-badges">
            {group.items.map(item => <span class={`chip chip-${group.color}`}>{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Base Layout */
  .skills {
    position: relative;
    width: 100%;
    padding: 4rem 0;
    background-color: var(--bg-base);
    overflow: hidden;
  }
  .skills-container { width: 100%; max-width: 76rem; margin: 0 auto; padding: 0 2rem; position: relative; z-index: 10; box-sizing: border-box; }

  /* Background Layers (copied/adapted from About for visual parity) */
  .skills-noise {
    position: absolute; inset: 0; z-index: 5; pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: var(--noise-op, 0.03); mix-blend-mode: overlay;
  }
  .skills-grid-bg {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background-image: linear-gradient(to right, var(--grid-color, rgba(28,25,23,0.05)) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-color, rgba(28,25,23,0.05)) 1px, transparent 1px);
    background-size: 3rem 3rem;
    mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 80%);
    transition: background-image 0.5s ease;
  }
  .skills-aurora-container { position: absolute; inset: 0; z-index: 2; overflow: hidden; pointer-events: none; }
  .skills-aurora {
    position: absolute; width: 45vw; height: 45vh; border-radius: 50%;
    filter: blur(80px); opacity: 0.7;
    animation: skillsAuroraMove 15s ease-in-out infinite alternate;
    transition: background 0.5s ease;
  }
  .skills-aurora-1 { top: 0; left: 8%; background: radial-gradient(circle, var(--a-1, rgba(59,130,246,0.15)) 0%, transparent 70%); }
  .skills-aurora-2 { bottom: 5%; right: 8%; background: radial-gradient(circle, var(--a-2, rgba(168,85,247,0.12)) 0%, transparent 70%); animation-delay: -5s; }
  .skills-aurora-3 { top: 35%; left: 38%; width: 36vw; background: radial-gradient(circle, color-mix(in srgb, var(--teal) 15%, transparent) 0%, transparent 70%); animation-delay: -10s; }
  @keyframes skillsAuroraMove {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(8%, 8%) scale(1.15); }
  }
  .skills-sparkles { position: absolute; inset: 0; z-index: 4; overflow: hidden; pointer-events: none; }
  :global(.skills-sparkle) {
    position: absolute; border-radius: 50%; background-color: var(--sparkle-color, rgba(15,23,42,0.15));
    box-shadow: 0 0 10px 1px var(--sparkle-color, rgba(15,23,42,0.15)); opacity: 0;
    animation: skillsFloatUp var(--duration) linear infinite; animation-delay: var(--delay);
  }
  @keyframes skillsFloatUp {
    0% { transform: translateY(0) scale(0); opacity: 0; }
    10% { opacity: 1; transform: translateY(-10px) scale(1); }
    90% { opacity: 1; transform: translateY(calc(var(--distance) - 10px)) scale(1); }
    100% { transform: translateY(var(--distance)) scale(0); opacity: 0; }
  }
  .skills-spotlight {
    position: absolute; inset: 0; z-index: 6; pointer-events: none;
    background: radial-gradient(800px circle at var(--mx, 50%) var(--my, 50%), var(--spot-color, rgba(15,23,42,0.03)), transparent 40%);
  }

  /* Header */
  .skills-head { text-align: center; max-width: 40rem; margin: 0 auto 2.25rem; position: relative; z-index: 10; }
  .eyebrow-wrapper { display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .dot { width: 8px; height: 8px; background: var(--primary); border-radius: 50%; }
  .grad { color: var(--primary); }

  /* Grid */
  .skills-grid { position: relative; z-index: 10; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; }
  
  .skill-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 1.35rem;
    border-radius: 18px;
    backdrop-filter: blur(20px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }
  .hover-glow {
    position: absolute; inset: 0; z-index: 1;
    background: radial-gradient(400px circle at var(--hx, 50%) var(--hy, 50%), rgba(59, 130, 246, 0.15), transparent 50%);
    opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
  }
  .track-cursor:hover .hover-glow { opacity: 1; }

  .skill-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; }
  .skill-top .glow-card-icon { margin-bottom: 0; }

  /* A11y fix: solid gold background + near-black text gives a safe >4.5:1 contrast
     ratio in both themes, instead of relying on --text over a translucent gold tint. */
  .skill-icon {
    background: var(--gold);
    color: #1C1917;
    font-weight: 600;
  }
  .skill-card-title { font-size: 1rem; margin-bottom: 0.35rem; }
  .skill-card-desc { font-size: 0.85rem; margin: 0 0 0.9rem; }
  .skill-badges { display: flex; flex-wrap: wrap; gap: 0.45rem; }

  /* Utilities */
  .reveal { opacity: 0; transform: translateY(30px); transition: all 0.8s ease; }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }

  /* Responsive */
  @media (max-width: 900px) {
    .skills { padding: 3.5rem 0; }
    .skills-head { margin-bottom: 2rem; }
  }

  /* Compact mobile */
  @media (max-width: 640px) {
    .skills { padding: 3rem 0; }
    .skills-container { padding: 0 1rem; }
    .skills-head { margin: 0 auto 1.75rem; }
    #skills h2 { font-size: 1.5rem; }
    #skills .eyebrow { font-size: 0.62rem; }
    #skills .subtitle { font-size: 0.8rem; }
    .skills-grid { grid-template-columns: 1fr; gap: 0.75rem; }
    .skill-card { padding: 0.9rem; border-radius: 14px; }
    .skill-top { margin-bottom: 0.6rem; }
    .skill-icon { width: 2.1rem; height: 2.1rem; font-size: 1rem; }
    .skill-index { font-size: 0.65rem; }
    .skill-card-title { font-size: 0.88rem; margin-bottom: 0.25rem; }
    .skill-card-desc { font-size: 0.74rem; margin-bottom: 0.65rem; }
    .skill-badges { gap: 0.3rem; }
  }
</style>

<script is:inline>
  (() => {
    // Hover Glow, Spotlight & Mouse tracking (matches About behavior)
    const section = document.querySelector("#skills.skills");
    const spot = document.getElementById("skills-spot");

    if (section && spot) {
      section.addEventListener("mousemove", (e) => {
        const rect = section.getBoundingClientRect();
        spot.style.setProperty("--mx", `${e.clientX - rect.left}px`);
        spot.style.setProperty("--my", `${e.clientY - rect.top}px`);

        document.querySelectorAll("#skills .track-cursor").forEach((el) => {
          const cardRect = el.getBoundingClientRect();
          el.style.setProperty("--hx", `${e.clientX - cardRect.left}px`);
          el.style.setProperty("--hy", `${e.clientY - cardRect.top}px`);
        });
      });
    }

    // Floating sparkles (copied from About)
    const sparklesContainer = document.getElementById("skills-sparkles");

    // Lightweight canvas-based sparkle renderer (replaces per-particle DOM nodes for perf)
    function mountSparkleCanvas(container, count, fallbackColor) {
      const canvas = document.createElement("canvas");
      canvas.style.cssText = "position:absolute;inset:0;width:100%;height:100%;display:block;";
      container.appendChild(canvas);
      const ctx = canvas.getContext("2d");
      const color = (getComputedStyle(container).getPropertyValue("--sparkle-color") || "").trim() || fallbackColor;
      let w = 0, h = 0, raf = null;
      const resize = () => { w = canvas.width = container.clientWidth; h = canvas.height = container.clientHeight; };
      resize();
      window.addEventListener("resize", resize);
      const particles = Array.from({ length: count }, () => ({
        x: Math.random() * 100,
        y: Math.random() * 120 - 10,
        r: Math.random() * 1.5 + 0.5,
        speed: Math.random() * 0.012 + 0.006,
        drift: (Math.random() - 0.5) * 0.015,
        phase: Math.random() * Math.PI * 2,
      }));
      function draw() {
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = color;
        for (const p of particles) {
          p.y -= p.speed;
          p.x += p.drift;
          if (p.y < -10) { p.y = 110; p.x = Math.random() * 100; }
          const alpha = 0.35 + 0.65 * Math.pow(Math.sin(p.phase + p.y * 0.05), 2);
          ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
          ctx.beginPath();
          ctx.arc((p.x / 100) * w, (p.y / 100) * h, p.r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
        raf = requestAnimationFrame(draw);
      }
      draw();
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) { if (raf) cancelAnimationFrame(raf); raf = null; }
        else if (!raf) draw();
      });
    }

    if (sparklesContainer && window.innerWidth > 768) {
      // Perf: single <canvas> + rAF loop instead of 18 individual DOM nodes/animations
      mountSparkleCanvas(sparklesContainer, 18, "rgba(15,23,42,0.15)");
    }

    // Reveal on scroll (unobserve when visible)
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );
    document.querySelectorAll("#skills [data-reveal]").forEach((el) => observer.observe(el));

    // Subtle 3D tilt on cards (like About)
    if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches && window.innerWidth > 900) {
      document.querySelectorAll("#skills [data-tilt]").forEach((card) => {
        let rafId = null;
        card.addEventListener("mousemove", (e) => {
          const rect = card.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width - 0.5;
          const py = (e.clientY - rect.top) / rect.height - 0.5;
          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => {
            card.style.transform = `perspective(1000px) rotateY(${px * 6}deg) rotateX(${-py * 6}deg) translateY(-4px)`;
          });
        });
        card.addEventListener("mouseleave", () => {
          if (rafId) cancelAnimationFrame(rafId);
          card.style.transform = "perspective(1000px) rotateY(0deg) rotateX(0deg) translateY(0)";
        });
      });
    }
  })();
</script>