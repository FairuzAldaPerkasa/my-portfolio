---
const stack = [
  { category: "Frontend", color: "indigo", items: ["React", "Next.js", "Astro", "Tailwind CSS"] },
  { category: "Backend", color: "coral", items: ["Node.js", "Express", "Django"] },
  { category: "AI / ML", color: "teal", items: ["TensorFlow", "PyTorch", "OpenAI API"] },
  { category: "Database", color: "sunshine", items: ["PostgreSQL", "MongoDB", "MySQL"] },
  { category: "Tools", color: "pink", items: ["Git", "Docker", "Figma", "Postman"] },
  { category: "Cloud", color: "indigo", items: ["AWS", "Vercel", "Google Cloud"] },
];
---
<section id="techstack" class="section techstack">
  <div class="techstack-sparkles" id="techstack-sparkles" aria-hidden="true"></div>
  <div class="techstack-noise" aria-hidden="true"></div>
  <div class="techstack-grid-bg" aria-hidden="true"></div>
  <div class="techstack-aurora-container" aria-hidden="true">
    <div class="techstack-aurora techstack-aurora-1"></div>
    <div class="techstack-aurora techstack-aurora-2"></div>
    <div class="techstack-aurora techstack-aurora-3"></div>
  </div>
  <div class="techstack-spotlight" id="techstack-spot" aria-hidden="true"></div>

  <div class="techstack-container">
    <div class="section-head techstack-head reveal" data-reveal>
      <div class="eyebrow-wrapper">
        <span class="dot"></span>
        <p class="eyebrow mono">07_STACK</p>
      </div>
      <h2>Tech <span class="grad">stack</span></h2>
      <p class="subtitle">The technologies I reach for most often, grouped by layer.</p>
    </div>

    <div class="stack-grid">
      {stack.map((group, gi) => (
        <article class={`card stack-card reveal track-cursor`} data-reveal data-tilt data-glow style={`--d:${gi * 0.06}s; --accent: var(--${group.color});`}>
          <div class="hover-glow"></div>
          <div class="stack-topline" aria-hidden="true"></div>
          <div class="editor-chrome">
            <span></span><span></span><span></span>
            <span class="file-name">stack-{group.category.toLowerCase().replace(/\s+/g, "-")}.md</span>
          </div>
          <div class="stack-body">
            <div class="stack-header">
              <div>
                <span class="stack-kicker mono">LAYER {gi + 1}</span>
                <h3 class="stack-title">{group.category}</h3>
                <p class="stack-meta text-muted">Core tools I use most in this layer.</p>
              </div>
              <span class="stack-lens" aria-hidden="true"></span>
            </div>
            <div class="stack-items">
              {group.items.map((item) => (
                <span class={`chip chip-${group.color} stack-item`}>{item}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .techstack {
    position: relative;
    width: 100%;
    padding: 4.5rem 0;
    background-color: var(--bg-base, var(--bg));
    overflow: hidden;
  }

  .techstack-container {
    width: 100%;
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 10;
    box-sizing: border-box;
  }

  .techstack-noise,
  .techstack-grid-bg,
  .techstack-spotlight,
  .techstack-sparkles,
  .techstack-aurora-container {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .techstack-noise {
    z-index: 5;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: var(--noise-op, 0.03);
    mix-blend-mode: overlay;
  }

  .techstack-grid-bg {
    z-index: 1;
    background-image: linear-gradient(to right, var(--grid-color, rgba(28,25,23,0.05)) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-color, rgba(28,25,23,0.05)) 1px, transparent 1px);
    background-size: 3rem 3rem;
    mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 80%);
  }

  .techstack-sparkles {
    z-index: 4;
    overflow: hidden;
  }

  :global(.techstack-sparkle) {
    position: absolute;
    border-radius: 50%;
    background-color: var(--sparkle-color, rgba(79,70,229,0.16));
    box-shadow: 0 0 10px 1px var(--sparkle-color, rgba(79,70,229,0.16));
    opacity: 0;
    animation: techstackFloatUp var(--duration) linear infinite;
    animation-delay: var(--delay);
  }

  @keyframes techstackFloatUp {
    0% { transform: translateY(0) scale(0); opacity: 0; }
    10% { opacity: 1; transform: translateY(-10px) scale(1); }
    90% { opacity: 1; transform: translateY(calc(var(--distance) - 10px)) scale(1); }
    100% { transform: translateY(var(--distance)) scale(0); opacity: 0; }
  }

  .techstack-aurora-container { z-index: 2; overflow: hidden; }

  .techstack-aurora {
    position: absolute;
    width: 45vw;
    height: 45vh;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.7;
    animation: techstackAuroraMove 15s ease-in-out infinite alternate;
  }

  .techstack-aurora-1 { top: 0; left: 8%; background: radial-gradient(circle, rgba(79,70,229,0.14) 0%, transparent 70%); }
  .techstack-aurora-2 { bottom: 5%; right: 8%; background: radial-gradient(circle, rgba(255,107,107,0.12) 0%, transparent 70%); animation-delay: -5s; }
  .techstack-aurora-3 { top: 35%; left: 38%; width: 36vw; background: radial-gradient(circle, color-mix(in srgb, var(--teal) 12%, transparent) 0%, transparent 70%); animation-delay: -10s; }

  @keyframes techstackAuroraMove { 0% { transform: translate(0, 0) scale(1); } 100% { transform: translate(8%, 8%) scale(1.15); } }

  .techstack-spotlight {
    z-index: 6;
    background: radial-gradient(800px circle at var(--mx, 50%) var(--my, 50%), rgba(79,70,229,0.05), transparent 40%);
  }

  .techstack-head {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 2.25rem;
    position: relative;
    z-index: 10;
  }

  .eyebrow-wrapper { display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .dot { width: 8px; height: 8px; background: var(--primary); border-radius: 50%; }
  .grad { color: var(--primary); }

  .stack-grid { position: relative; z-index: 10; display: grid; grid-template-columns: repeat(auto-fit,minmax(260px,1fr)); gap: 1rem; }

  .stack-card {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface) 96%, transparent), color-mix(in srgb, var(--bg-alt) 82%, transparent));
    border-radius: 24px;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
    backdrop-filter: blur(20px);
    padding: 0;
  }

  .hover-glow {
    position: absolute; inset: 0; z-index: 1;
    background: radial-gradient(400px circle at var(--hx, 50%) var(--hy, 50%), color-mix(in srgb, var(--accent) 24%, transparent), transparent 50%);
    opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
  }
  .track-cursor:hover .hover-glow { opacity: 1; }

  .stack-topline {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 35%, transparent), transparent);
    z-index: 2;
    opacity: 0.95;
  }

  .stack-body {
    position: relative;
    z-index: 3;
    padding: 1.35rem 1.4rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .stack-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .stack-kicker {
    display: inline-block;
    font-size: 0.76rem;
    color: color-mix(in srgb, var(--accent) 70%, var(--text-muted));
    margin-bottom: 0.4rem;
    letter-spacing: 0.08em;
  }

  .stack-title {
    font-weight: 600;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
  }

  .stack-meta {
    margin: 0.45rem 0 0;
    max-width: 20rem;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .stack-lens { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: color-mix(in srgb, var(--accent) 85%, white); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 12%, transparent); }
  .stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: flex-start;
  }

  .stack-item {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    white-space: nowrap;
    padding-inline: 0.8rem;
  }

  .stack-item { transition: transform 0.2s var(--ease); }
  .stack-item:hover { transform: translateY(-3px) scale(1.05); }

  .stack-card p { margin: 0; }

  .stack-card .chip {
    max-width: 100%;
  }

  .stack-card .chip,
  .stack-card .stack-item {
    min-height: 2.1rem;
  }

  .stack-card:hover {
    box-shadow: 0 22px 50px -26px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .stack-card:hover .stack-lens {
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 15%, transparent);
  }

  @media (max-width: 640px) {
    .techstack-container { padding: 0 1.25rem; }
    .stack-grid { grid-template-columns: 1fr; }
    .stack-body { padding: 1.45rem 1.25rem 1.5rem; gap: 0.95rem; }
    .stack-items { gap: 0.5rem; }
  }

  /* Compact mobile */
  @media (max-width: 640px) {
    .techstack { padding: 3rem 0; }
    .techstack-container { padding: 0 1rem; }
    .techstack-head { margin: 0 auto 1.75rem; }
    #techstack h2 { font-size: 1.5rem; }
    #techstack .eyebrow { font-size: 0.62rem; }
    #techstack .subtitle { font-size: 0.8rem; }
    .stack-grid { gap: 0.6rem; }
    .stack-body { padding: 0.8rem 0.75rem 0.85rem; gap: 0.55rem; }
    .stack-title { font-size: 0.9rem; }
    .stack-kicker { font-size: 0.62rem; margin-bottom: 0.25rem; }
    .stack-meta { font-size: 0.75rem; margin-top: 0.3rem; }
    .stack-lens { width: 0.5rem; height: 0.5rem; }
    .stack-items { gap: 0.35rem; }
    .stack-item, .stack-card .chip { min-height: 1.6rem; padding-inline: 0.55rem; font-size: 0.7rem; }
  }
</style>

<script is:inline>
  (() => {
    const section = document.querySelector("#techstack.techstack");
    const spotlight = document.getElementById("techstack-spot");
    const sparklesContainer = document.getElementById("techstack-sparkles");

    if (section && spotlight) {
      section.addEventListener("mousemove", (e) => {
        const rect = section.getBoundingClientRect();
        spotlight.style.setProperty("--mx", `${e.clientX - rect.left}px`);
        spotlight.style.setProperty("--my", `${e.clientY - rect.top}px`);

        document.querySelectorAll("#techstack .track-cursor").forEach((card) => {
          const cardRect = card.getBoundingClientRect();
          card.style.setProperty("--hx", `${e.clientX - cardRect.left}px`);
          card.style.setProperty("--hy", `${e.clientY - cardRect.top}px`);
        });
      });
    }


    // Lightweight canvas-based sparkle renderer (replaces per-particle DOM nodes for perf)
    function mountSparkleCanvas(container, count, fallbackColor) {
      const canvas = document.createElement("canvas");
      canvas.style.cssText = "position:absolute;inset:0;width:100%;height:100%;display:block;";
      container.appendChild(canvas);
      const ctx = canvas.getContext("2d");
      const color = (getComputedStyle(container).getPropertyValue("--sparkle-color") || "").trim() || fallbackColor;
      let w = 0, h = 0, raf = null;
      const resize = () => { w = canvas.width = container.clientWidth; h = canvas.height = container.clientHeight; };
      resize();
      window.addEventListener("resize", resize);
      const particles = Array.from({ length: count }, () => ({
        x: Math.random() * 100,
        y: Math.random() * 120 - 10,
        r: Math.random() * 1.5 + 0.5,
        speed: Math.random() * 0.012 + 0.006,
        drift: (Math.random() - 0.5) * 0.015,
        phase: Math.random() * Math.PI * 2,
      }));
      function draw() {
        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = color;
        for (const p of particles) {
          p.y -= p.speed;
          p.x += p.drift;
          if (p.y < -10) { p.y = 110; p.x = Math.random() * 100; }
          const alpha = 0.35 + 0.65 * Math.pow(Math.sin(p.phase + p.y * 0.05), 2);
          ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
          ctx.beginPath();
          ctx.arc((p.x / 100) * w, (p.y / 100) * h, p.r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
        raf = requestAnimationFrame(draw);
      }
      draw();
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) { if (raf) cancelAnimationFrame(raf); raf = null; }
        else if (!raf) draw();
      });
    }

    if (sparklesContainer && window.innerWidth > 768) {
      // Perf: single <canvas> + rAF loop instead of 16 individual DOM nodes/animations
      mountSparkleCanvas(sparklesContainer, 16, "rgba(79,70,229,0.16)");
    }

    const revealEls = document.querySelectorAll("#techstack [data-reveal]");
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    revealEls.forEach((el) => revealObserver.observe(el));

    if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches && window.innerWidth > 900) {
      document.querySelectorAll("#techstack [data-tilt]").forEach((card) => {
        let rafId = null;
        card.addEventListener("mousemove", (e) => {
          const rect = card.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width - 0.5;
          const py = (e.clientY - rect.top) / rect.height - 0.5;
          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => {
            card.style.transform = `perspective(1000px) rotateY(${px * 6}deg) rotateX(${-py * 6}deg) translateY(-4px)`;
          });
        });
        card.addEventListener("mouseleave", () => {
          if (rafId) cancelAnimationFrame(rafId);
          card.style.transform = "perspective(1000px) rotateY(0deg) rotateX(0deg) translateY(0)";
        });
      });
    }
  })();
</script>